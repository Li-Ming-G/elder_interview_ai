{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/memory-p3-retrieval-v1.schema.json",
  "title": "Memory P3 Retrieval V1 contract surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope", "query", "configuration", "storage", "embedding", "candidates", "graph_edges"],
  "properties": {
    "contract_version": { "const": "memory-p3-retrieval-v1" },
    "scope": { "$ref": "#/$defs/scope" },
    "query": { "$ref": "#/$defs/query" },
    "configuration": { "$ref": "#/$defs/configuration" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "postgresql-pgvector-v1" } }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "model_status"],
      "properties": {
        "port": { "const": "provider-neutral" },
        "model_status": { "const": "deferred" },
        "provider_id": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "graph_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/graphEdge" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "current_session_id"],
      "properties": {
        "project_id": { "$ref": "#/$defs/uuid" },
        "current_session_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "workingSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_memory_id", "thread_id", "revision", "kind", "status"],
      "properties": {
        "working_memory_id": { "type": "string", "minLength": 1 },
        "thread_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["episode", "fact"] },
        "status": { "enum": ["current", "uncertain", "disputed"] },
        "query_text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["working_signals"],
      "properties": {
        "working_signals": {
          "type": "array",
          "items": { "$ref": "#/$defs/workingSignal" }
        },
        "query_vector": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding_threshold", "candidate_limit", "graph_neighbor_depth", "graph_neighbor_limit"],
      "properties": {
        "embedding_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidate_limit": { "type": "integer", "minimum": 1 },
        "graph_neighbor_depth": { "type": "integer", "minimum": 0 },
        "graph_neighbor_limit": { "type": "integer", "minimum": 0 }
      }
    },
    "layerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_identity_id", "project_id", "origin_session_id", "origin_thread_id", "origin_resolution_id"],
      "properties": {
        "layer_identity_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "origin_session_id": { "$ref": "#/$defs/uuid" },
        "origin_thread_id": { "$ref": "#/$defs/uuid" },
        "origin_resolution_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "authority_id", "revision", "source_level", "source_session_ids", "kind", "status", "safe_content", "layer_identity", "retrieval_sources", "embedding_score", "graph_distance", "score", "rank"],
      "properties": {
        "memory_id": { "type": "string", "minLength": 1 },
        "authority_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "source_level": { "enum": ["mid", "long"] },
        "source_session_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "kind": { "enum": ["episode", "fact"] },
        "status": { "enum": ["current", "uncertain", "disputed"] },
        "safe_content": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "layer_identity": { "$ref": "#/$defs/layerIdentity" },
        "retrieval_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["embedding", "graph_neighbor"] }
        },
        "embedding_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "graph_distance": { "type": ["integer", "null"], "minimum": 0 },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "rank": { "type": "integer", "minimum": 0 }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "from", "to"],
      "properties": {
        "relation": { "enum": ["CONTINUATION", "RESUME", "BRANCH", "RELATED"] },
        "from": { "$ref": "#/$defs/layerIdentity" },
        "to": { "$ref": "#/$defs/layerIdentity" }
      }
    }
  }
}
