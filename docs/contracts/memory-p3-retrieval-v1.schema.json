{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/memory-p3-retrieval-v1.schema.json",
  "title": "Memory P3 Retrieval V1 contract surface",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "active_thread_id": { "type": "null" } } },
      "then": { "properties": { "active_thread_revision": { "type": "null" } } }
    },
    {
      "if": { "properties": { "active_thread_id": { "type": "string" } } },
      "then": { "properties": { "active_thread_revision": { "type": "integer", "minimum": 1 } } }
    }
  ],
  "required": ["contract_version", "project_id", "current_session_id", "active_thread_id", "active_thread_revision", "current_working_signals", "recent_eligible_transcript_signals", "configuration", "storage", "embedding", "candidates", "graph_edges"],
  "properties": {
    "contract_version": { "const": "memory-p3-retrieval-v1" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "current_session_id": { "$ref": "#/$defs/uuid" },
    "active_thread_id": { "type": ["string", "null"], "format": "uuid" },
    "active_thread_revision": { "type": ["integer", "null"], "minimum": 1 },
    "current_working_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/workingSignal" }
    },
    "recent_eligible_transcript_signals": {
      "type": "array",
      "items": { "$ref": "#/$defs/recentTranscriptSignal" }
    },
    "query_vector": {
      "type": "array",
      "items": { "type": "number" }
    },
    "configuration": { "$ref": "#/$defs/configuration" },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "postgresql-pgvector-v1" } }
    },
    "embedding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port", "model_status"],
      "properties": {
        "port": { "const": "provider-neutral" },
        "model_status": { "const": "deferred" },
        "provider_id": { "type": "string", "minLength": 1 },
        "dimensions": { "type": "integer", "minimum": 1 }
      }
    },
    "candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    },
    "graph_edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/graphEdge" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "workingSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal_id", "working_memory_id", "thread_id", "revision", "semantic_kind", "semantic_status"],
      "properties": {
        "signal_id": { "type": "string", "minLength": 1 },
        "working_memory_id": { "type": "string", "minLength": 1 },
        "thread_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "query_text": { "type": "string", "minLength": 1, "maxLength": 4000 }
      }
    },
    "recentTranscriptSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "session_id", "text_revision", "speaker_role_revision", "effective_text_digest", "eligibility"],
      "properties": {
        "segment_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "text_revision": { "type": "integer", "minimum": 0 },
        "speaker_role_revision": { "type": "integer", "minimum": 0 },
        "effective_text_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eligibility": { "const": "trusted-elder-final-conversation" },
        "bounded_query_text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embedding_threshold", "candidate_limit", "graph_depth", "graph_limit"],
      "properties": {
        "embedding_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "candidate_limit": { "type": "integer", "minimum": 1 },
        "graph_depth": { "type": "integer", "minimum": 0 },
        "graph_limit": { "type": "integer", "minimum": 0 }
      }
    },
    "layerIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_identity_id", "project_id", "origin_session_id", "origin_thread_id", "origin_resolution_authority_id"],
      "properties": {
        "layer_identity_id": { "$ref": "#/$defs/uuid" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "origin_session_id": { "$ref": "#/$defs/uuid" },
        "origin_thread_id": { "$ref": "#/$defs/uuid" },
        "origin_resolution_authority_id": { "$ref": "#/$defs/uuid" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_id", "resolution_authority_id", "revision_id", "source_level", "semantic_kind", "semantic_status", "safe_content", "retrieval_sources", "embedding_score", "graph_distance", "rank"],
      "properties": {
        "memory_id": { "$ref": "#/$defs/uuid" },
        "resolution_authority_id": { "$ref": "#/$defs/uuid" },
        "revision_id": { "$ref": "#/$defs/uuid" },
        "revision_no": { "type": "integer", "minimum": 1 },
        "source_level": { "enum": ["mid", "long"] },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "safe_content": { "type": "string", "minLength": 1, "maxLength": 12000 },
        "retrieval_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["embedding", "graph"] }
        },
        "embedding_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "graph_distance": { "type": ["integer", "null"], "minimum": 0 },
        "rank": { "type": "integer", "minimum": 0 }
      }
    },
    "graphEdge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relation", "from", "to"],
      "properties": {
        "relation": { "enum": ["CONTINUATION", "RESUME", "BRANCH", "RELATED"] },
        "from": { "$ref": "#/$defs/layerIdentity" },
        "to": { "$ref": "#/$defs/layerIdentity" }
      }
    }
  }
}
