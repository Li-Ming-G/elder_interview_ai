    { "name": "trace retention target must exist", "valid": false, "expected_error": "PERSISTENCE_RETENTION_ROOT_TARGET_UNKNOWN" },
    { "name": "scope session set is exact", "valid": false, "expected_error": "PERSISTENCE_SCOPE_SESSION_SET_MISMATCH" }
    ,{ "name": "retry predecessor must be terminal retryable", "valid": false, "expected_error": "PERSISTENCE_JOB_RETRY_PREDECESSOR_NOT_TERMINAL_RETRYABLE" }
  ]
