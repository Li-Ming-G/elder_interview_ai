{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.example/schemas/memory-maintainer-context-v1.schema.json",
  "title": "MemoryMaintainerContextV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_schema_version",
    "trigger",
    "transcript_membership",
    "active_thread",
    "current_working_memory",
    "session_mid_index",
    "active_boundaries"
  ],
  "properties": {
    "context_schema_version": { "const": "memory-maintainer-context-v1" },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": { "enum": ["batch_threshold", "time_threshold"] },
        "identity": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    },
    "transcript_membership": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "contains": {
        "type": "object",
        "required": ["membership_kind", "trusted_role", "content_kind"],
        "properties": {
          "membership_kind": { "const": "new" },
          "trusted_role": { "const": "elder" },
          "content_kind": { "const": "conversation" }
        }
      },
      "minContains": 1,
      "items": { "$ref": "#/$defs/transcriptMembership" }
    },
    "active_thread": {
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/threadReference" }]
    },
    "current_working_memory": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/workingMemory" }
    },
    "session_mid_index": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/memoryReference" }
    },
    "active_boundaries": {
      "type": "array",
      "maxItems": 40,
      "items": { "$ref": "#/$defs/boundaryReference" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "memoryType": {
      "enum": [
        "person",
        "relationship",
        "place",
        "event",
        "time",
        "time_range",
        "important_choice",
        "reason_clue",
        "unfinished_story"
      ]
    },
    "transcriptMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "session_id",
        "membership_kind",
        "start_ms",
        "text",
        "trusted_role",
        "text_revision",
        "speaker_role_revision",
        "effective_text_digest",
        "content_kind"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "membership_kind": { "enum": ["new", "overlap"] },
        "start_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
        "trusted_role": { "enum": ["elder", "interviewer"] },
        "text_revision": { "type": "integer", "minimum": 1 },
        "speaker_role_revision": { "type": "integer", "minimum": 0 },
        "effective_text_digest": { "$ref": "#/$defs/digest" },
        "content_kind": { "const": "conversation" }
      }
    },
    "threadReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["thread_id", "revision", "status", "topic_key"],
      "properties": {
        "thread_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["active", "parked"] },
        "topic_key": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "workingMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "revision",
        "thread_id",
        "semantic_kind",
        "memory_type",
        "canonical_key",
        "value_kind",
        "value",
        "status"
      ],
      "properties": {
        "resolution_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "thread_id": { "$ref": "#/$defs/uuid" },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "memory_type": { "$ref": "#/$defs/memoryType" },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 240 },
        "value_kind": { "enum": ["exact", "range", "unknown"] },
        "value": true,
        "status": { "enum": ["current", "uncertain", "disputed"] }
      }
    },
    "memoryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolution_id",
        "revision",
        "thread_id",
        "thread_revision",
        "canonical_key",
        "semantic_kind",
        "memory_type",
        "status",
        "membership_digest"
      ],
      "properties": {
        "resolution_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "thread_id": { "$ref": "#/$defs/uuid" },
        "thread_revision": { "type": "integer", "minimum": 1 },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 240 },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "memory_type": { "$ref": "#/$defs/memoryType" },
        "status": { "enum": ["current", "uncertain", "disputed"] },
        "membership_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "boundaryReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary_id", "revision", "code", "abstract_scope", "status"],
      "properties": {
        "boundary_id": { "$ref": "#/$defs/uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "code": { "const": "elder_explicit_boundary" },
        "abstract_scope": { "type": "string", "minLength": 1, "maxLength": 240 },
        "status": { "const": "active" }
      }
    }
  }
}
