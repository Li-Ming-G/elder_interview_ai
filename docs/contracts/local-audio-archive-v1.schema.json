{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.example/contracts/local-audio-archive-v1.schema.json",
  "title": "LocalAudioArchiveV1",
  "description": "Formal client-only projection and delete result for the current origin's IndexedDB interview archive. It is not a server deletion request or cross-device archive.",
  "x-contract-status": "formal",
  "oneOf": [
    { "$ref": "#/$defs/projection" },
    { "$ref": "#/$defs/deleteResult" },
    { "$ref": "#/$defs/deletionReceipt" }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "session_id",
        "state",
        "state_basis",
        "archive_bytes",
        "archive_chunk_count",
        "pending_delivery_count",
        "origin_storage",
        "playback_available",
        "server_audio_retained"
      ],
      "properties": {
        "contract_version": { "const": "local-audio-archive-v1" },
        "kind": { "const": "projection" },
        "session_id": { "type": "string", "format": "uuid" },
        "state": {
          "enum": [
            "available_complete",
            "available_incomplete",
            "deleted_on_device",
            "missing_unknown",
            "blocked_active_or_dirty",
            "blocked_pending_delivery",
            "blocked_server_unverified"
          ]
        },
        "state_basis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "active_or_dirty",
            "server_manifest_verified",
            "deletion_receipt_present",
            "local_archive_complete"
          ],
          "properties": {
            "active_or_dirty": { "type": "boolean" },
            "server_manifest_verified": { "type": "boolean" },
            "deletion_receipt_present": { "type": "boolean" },
            "local_archive_complete": { "type": "boolean" }
          }
        },
        "archive_bytes": { "$ref": "#/$defs/nonNegativeInteger" },
        "archive_chunk_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "pending_delivery_count": { "$ref": "#/$defs/nonNegativeInteger" },
        "origin_storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accuracy", "usage_bytes", "quota_bytes", "available_bytes"],
          "properties": {
            "accuracy": { "const": "origin_wide_approximate" },
            "usage_bytes": {
              "anyOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }]
            },
            "quota_bytes": {
              "anyOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }]
            },
            "available_bytes": {
              "anyOf": [{ "$ref": "#/$defs/nonNegativeInteger" }, { "type": "null" }]
            }
          }
        },
        "playback_available": { "type": "boolean" },
        "server_audio_retained": { "const": true }
      },
      "allOf": [
        {
          "if": { "properties": { "archive_chunk_count": { "const": 0 } } },
          "then": { "properties": { "archive_bytes": { "const": 0 } } }
        },
        {
          "if": { "properties": { "archive_bytes": { "const": 0 } } },
          "then": { "properties": { "archive_chunk_count": { "const": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "available_complete" } } },
          "then": {
            "properties": {
              "archive_bytes": { "type": "integer", "minimum": 1 },
              "archive_chunk_count": { "type": "integer", "minimum": 1 },
              "pending_delivery_count": { "const": 0 },
              "state_basis": {
                "properties": {
                  "active_or_dirty": { "const": false },
                  "server_manifest_verified": { "const": true },
                  "deletion_receipt_present": { "const": false },
                  "local_archive_complete": { "const": true }
                }
              },
              "playback_available": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "available_incomplete" } } },
          "then": {
            "properties": {
              "archive_bytes": { "type": "integer", "minimum": 1 },
              "archive_chunk_count": { "type": "integer", "minimum": 1 },
              "pending_delivery_count": { "const": 0 },
              "state_basis": {
                "properties": {
                  "active_or_dirty": { "const": false },
                  "server_manifest_verified": { "const": true },
                  "deletion_receipt_present": { "const": false },
                  "local_archive_complete": { "const": false }
                }
              },
              "playback_available": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "deleted_on_device" } } },
          "then": {
            "properties": {
              "archive_bytes": { "const": 0 },
              "archive_chunk_count": { "const": 0 },
              "pending_delivery_count": { "const": 0 },
              "state_basis": {
                "properties": {
                  "active_or_dirty": { "const": false },
                  "deletion_receipt_present": { "const": true },
                  "local_archive_complete": { "const": false }
                }
              },
              "playback_available": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "missing_unknown" } } },
          "then": {
            "properties": {
              "archive_bytes": { "const": 0 },
              "archive_chunk_count": { "const": 0 },
              "pending_delivery_count": { "const": 0 },
              "state_basis": {
                "properties": {
                  "active_or_dirty": { "const": false },
                  "deletion_receipt_present": { "const": false },
                  "local_archive_complete": { "const": false }
                }
              },
              "playback_available": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "blocked_active_or_dirty" } } },
          "then": {
            "properties": {
              "state_basis": {
                "properties": { "active_or_dirty": { "const": true } }
              },
              "playback_available": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "blocked_pending_delivery" } } },
          "then": {
            "properties": {
              "archive_bytes": { "type": "integer", "minimum": 1 },
              "archive_chunk_count": { "type": "integer", "minimum": 1 },
              "pending_delivery_count": { "type": "integer", "minimum": 1 },
              "state_basis": {
                "properties": { "active_or_dirty": { "const": false } }
              },
              "playback_available": { "const": false }
            }
          }
        },
        {
          "if": { "properties": { "state": { "const": "blocked_server_unverified" } } },
          "then": {
            "properties": {
              "archive_bytes": { "type": "integer", "minimum": 1 },
              "archive_chunk_count": { "type": "integer", "minimum": 1 },
              "pending_delivery_count": { "const": 0 },
              "state_basis": {
                "properties": {
                  "active_or_dirty": { "const": false },
                  "server_manifest_verified": { "const": false },
                  "deletion_receipt_present": { "const": false }
                }
              },
              "playback_available": { "const": false }
            }
          }
        }
      ]
    },
    "deleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "kind",
        "session_id",
        "result",
        "deleted_at",
        "server_audio_retained",
        "server_transcript_retained",
        "server_memory_retained"
      ],
      "properties": {
        "contract_version": { "const": "local-audio-archive-v1" },
        "kind": { "const": "delete_result" },
        "session_id": { "type": "string", "format": "uuid" },
        "result": {
          "enum": [
            "deleted",
            "already_deleted",
            "blocked_active_or_dirty",
            "blocked_pending_delivery",
            "blocked_server_unverified",
            "lock_unavailable",
            "transaction_aborted"
          ]
        },
        "deleted_at": { "type": ["string", "null"], "format": "date-time" },
        "server_audio_retained": { "const": true },
        "server_transcript_retained": { "const": true },
        "server_memory_retained": { "const": true }
      },
      "oneOf": [
        {
          "properties": {
            "result": { "enum": ["deleted", "already_deleted"] },
            "deleted_at": { "type": "string", "format": "date-time" }
          }
        },
        {
          "properties": {
            "result": {
              "enum": [
                "blocked_active_or_dirty",
                "blocked_pending_delivery",
                "blocked_server_unverified",
                "lock_unavailable",
                "transaction_aborted"
              ]
            },
            "deleted_at": { "type": "null" }
          }
        }
      ]
    },
    "deletionReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "kind", "session_id", "result", "deleted_at"],
      "properties": {
        "contract_version": { "const": "local-audio-archive-v1" },
        "kind": { "const": "deletion_receipt" },
        "session_id": { "type": "string", "format": "uuid" },
        "result": { "const": "deleted" },
        "deleted_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
