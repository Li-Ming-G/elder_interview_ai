{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/memory-semantic-proposal-v1.schema.json",
  "title": "Memory Semantic Proposal V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_schema_version", "source_manifest_hash", "proposals"],
  "properties": {
    "output_schema_version": { "const": "memory-semantic-proposal-v1" },
    "source_manifest_hash": { "$ref": "#/$defs/digest" },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "Pure semantic validation requires proposal_id, proposal_claim_ref_id, and target semantic slot (semantic_kind, canonical_key) to each be projection-wide unique. Source and evidence refs may be reused where ownership permits.",
      "items": { "$ref": "#/$defs/proposal" }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceRef": { "type": "string", "pattern": "^src:[A-Za-z0-9._:-]{1,120}$" },
    "claimRef": { "type": "string", "pattern": "^claim:[A-Za-z0-9._:-]{1,120}$" },
    "evidenceRef": { "type": "string", "pattern": "^evidence:[A-Za-z0-9._:-]{1,120}$" },
    "proposedClaim": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_claim_ref_id", "claim_key", "value_kind", "value", "source_claim_ref_ids", "evidence_ref_ids"],
      "properties": {
        "proposal_claim_ref_id": { "type": "string", "pattern": "^proposal-claim:[A-Za-z0-9._:-]{1,120}$" },
        "claim_key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value_kind": { "enum": ["exact", "range", "unknown"] },
        "value": { "$ref": "#/$defs/semanticValue" },
        "source_claim_ref_ids": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/claimRef" } },
        "evidence_ref_ids": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRef" } }
      }
    },
    "proposedState": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_kind", "memory_tag", "canonical_key", "value_kind", "value", "resolution_kind", "semantic_status", "claims"],
      "properties": {
        "semantic_kind": { "enum": ["episode", "fact"] },
        "memory_tag": { "oneOf": [{ "type": "null" }, { "enum": ["person", "relationship", "place", "event", "time", "time_range", "important_choice", "reason_clue", "unfinished_story"] }] },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 240 },
        "value_kind": { "oneOf": [{ "type": "null" }, { "enum": ["exact", "range", "unknown"] }] },
        "value": { "$ref": "#/$defs/semanticValue" },
        "resolution_kind": { "enum": ["single", "range", "unknown", "conflict_set"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "description": "proposal_claim_ref_id is globally unique. Evidence uniqueness is by (proposal_claim_ref_id, evidence_ref_id) pair; one evidence_ref_id may support multiple distinct claims.",
          "items": { "$ref": "#/$defs/proposedClaim" }
        }
      },
      "allOf": [{ "$ref": "#/$defs/resolutionSemantics" }]
    },
    "semanticValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/semanticValue" } },
        {
          "type": "object",
          "maxProperties": 80,
          "propertyNames": { "pattern": "^(?!.*(?:raw_transcript|transcript|prompt|provider_payload|provider_request|provider_response|sql|cas|lifecycle|database_id|db_id)).+$" },
          "additionalProperties": { "$ref": "#/$defs/semanticValue" }
        }
      ]
    },
    "resolutionSemantics": {
      "allOf": [
        {
          "if": { "type": "object", "properties": { "semantic_status": { "const": "disputed" } } },
          "then": {
            "type": "object",
            "properties": {
              "value_kind": { "type": "null" },
              "value": { "type": "null" },
              "resolution_kind": { "const": "conflict_set" },
              "claims": { "type": "array", "minItems": 2 }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "value_kind": { "enum": ["exact", "range", "unknown"] },
              "resolution_kind": { "enum": ["single", "range", "unknown"] }
            }
          }
        },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "exact" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "single" } } } },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "range" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "range" } } } },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "unknown" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "unknown" } } } }
      ]
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "existing_source_ref_id"],
      "properties": {
        "kind": { "enum": ["new_slot", "existing_slot"] },
        "existing_source_ref_id": { "oneOf": [{ "$ref": "#/$defs/sourceRef" }, { "type": "null" }] }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "new_slot" } } }, "then": { "properties": { "existing_source_ref_id": { "type": "null" } } } },
        { "if": { "properties": { "kind": { "const": "existing_slot" } } }, "then": { "properties": { "existing_source_ref_id": { "$ref": "#/$defs/sourceRef" } } } }
      ]
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "semantic_intent", "source_member_ref_ids", "target", "proposed_state", "reason_code"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^proposal:[A-Za-z0-9._:-]{1,120}$" },
        "semantic_intent": { "enum": ["derive", "merge", "reorganize", "compress", "mark_uncertain"] },
        "source_member_ref_ids": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
        "target": { "$ref": "#/$defs/target" },
        "proposed_state": { "$ref": "#/$defs/proposedState" },
        "reason_code": { "enum": ["new_semantic_slot", "duplicate_semantics", "episode_reorganization", "history_compression", "unresolved_evidence"] }
      }
    }
  }
}
