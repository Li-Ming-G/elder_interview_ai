{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/memory-semantic-context-v1.schema.json",
  "title": "Transient Memory Semantic Context V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_schema_version", "mode", "project_id", "source_session_id", "source_session_ids", "source_checkpoint", "source_members", "evidence_membership", "evidence_manifest_hash", "limits", "source_manifest_hash", "policy"],
  "properties": {
    "context_schema_version": { "const": "memory-semantic-context-v1" },
    "mode": { "enum": ["working_to_mid", "session_end_to_long"] },
    "project_id": { "$ref": "#/$defs/uuid" },
    "source_session_id": { "$ref": "#/$defs/uuid" },
    "source_session_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
    "source_checkpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "root_identity", "project_id", "source_session_ids", "expected_member_count", "member_manifest_hash", "evidence_manifest_hash", "source_set", "terminal_status"],
      "properties": {
        "checkpoint_id": { "$ref": "#/$defs/uuid" },
        "root_identity": { "$ref": "#/$defs/digest" },
        "project_id": { "$ref": "#/$defs/uuid" },
        "source_session_ids": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } },
        "expected_member_count": { "type": "integer", "minimum": 1, "maximum": 40 },
        "member_manifest_hash": { "$ref": "#/$defs/digest" },
        "evidence_manifest_hash": { "$ref": "#/$defs/digest" },
        "source_set": { "$ref": "#/$defs/sourceSet" },
        "terminal_status": { "const": "succeeded" }
      }
    },
    "source_members": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "Pure semantic validation additionally requires source_ref_id and durable resolution_id to each be globally unique across this array.",
      "items": { "$ref": "#/$defs/sourceMember" }
    },
    "evidence_membership": { "type": "array", "minItems": 1, "maxItems": 320, "items": { "$ref": "#/$defs/evidenceRef" } },
    "evidence_manifest_hash": { "$ref": "#/$defs/digest" },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_version", "max_source_members", "max_claims", "max_evidence_refs", "max_semantic_characters", "max_json_depth"],
      "properties": {
        "policy_version": { "type": "string", "minLength": 1, "maxLength": 80 },
        "max_source_members": { "type": "integer", "minimum": 1, "maximum": 40 },
        "max_claims": { "type": "integer", "minimum": 1, "maximum": 160 },
        "max_evidence_refs": { "type": "integer", "minimum": 1, "maximum": 320 },
        "max_semantic_characters": { "type": "integer", "minimum": 1, "maximum": 200000 },
        "max_json_depth": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "source_manifest_hash": { "$ref": "#/$defs/digest" },
    "policy": { "$ref": "#/$defs/policy" }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceRef": { "type": "string", "pattern": "^src:[A-Za-z0-9._:-]{1,120}$" },
    "claimRef": { "type": "string", "pattern": "^claim:[A-Za-z0-9._:-]{1,120}$" },
    "evidenceRefId": { "type": "string", "pattern": "^evidence:[A-Za-z0-9._:-]{1,120}$" },
    "evidenceRef": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_ref_id", "segment_id", "session_id", "text_revision", "speaker_role_revision", "effective_text_digest", "trusted_role", "content_kind", "input_order"],
      "properties": {
        "evidence_ref_id": { "$ref": "#/$defs/evidenceRefId" },
        "segment_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "text_revision": { "type": "integer", "minimum": 0 },
        "speaker_role_revision": { "type": "integer", "minimum": 0 },
        "effective_text_digest": { "$ref": "#/$defs/digest" },
        "trusted_role": { "const": "elder" },
        "content_kind": { "const": "conversation" },
        "input_order": { "type": "integer", "minimum": 0 }
      }
    },
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["source_claim_ref_id", "claim_key", "value_kind", "value", "evidence_ref_ids"],
      "properties": {
        "source_claim_ref_id": { "$ref": "#/$defs/claimRef" },
        "claim_key": { "type": "string", "minLength": 1, "maxLength": 160 },
        "value_kind": { "enum": ["exact", "range", "unknown"] },
        "value": { "$ref": "#/$defs/semanticValue" },
        "evidence_ref_ids": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/evidenceRefId" } }
      }
    },
    "semanticState": {
      "type": "object", "additionalProperties": false,
      "required": ["semantic_kind", "memory_tag", "canonical_key", "value_kind", "value", "resolution_kind", "semantic_status", "claims"],
      "properties": {
        "semantic_kind": { "enum": ["episode", "fact"] },
        "memory_tag": { "oneOf": [{ "type": "null" }, { "enum": ["person", "relationship", "place", "event", "time", "time_range", "important_choice", "reason_clue", "unfinished_story"] }] },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 240 },
        "value_kind": { "oneOf": [{ "type": "null" }, { "enum": ["exact", "range", "unknown"] }] },
        "value": { "$ref": "#/$defs/semanticValue" },
        "resolution_kind": { "enum": ["single", "range", "unknown", "conflict_set"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "claims": { "type": "array", "minItems": 1, "maxItems": 40, "items": { "$ref": "#/$defs/claim" } }
      },
      "allOf": [{ "$ref": "#/$defs/resolutionSemantics" }]
    },
    "sourceMember": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref_id", "source_kind", "project_id", "session_id", "resolution_id", "resolution_revision", "authority", "semantic_state", "content_digest", "input_order"],
      "properties": {
        "source_ref_id": { "$ref": "#/$defs/sourceRef" },
        "source_kind": { "enum": ["working_resolution", "mid_resolution", "current_resolution"] },
        "project_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "resolution_id": { "$ref": "#/$defs/uuid" },
        "resolution_revision": { "type": "integer", "minimum": 1 },
        "authority": { "enum": ["automatic", "human_confirmed"] },
        "semantic_state": { "$ref": "#/$defs/semanticState" },
        "content_digest": { "$ref": "#/$defs/digest" },
        "input_order": { "type": "integer", "minimum": 0 }
      }
    },
    "resolutionSemantics": {
      "allOf": [
        {
          "if": { "type": "object", "properties": { "semantic_status": { "const": "disputed" } } },
          "then": {
            "type": "object",
            "properties": {
              "value_kind": { "type": "null" },
              "value": { "type": "null" },
              "resolution_kind": { "const": "conflict_set" },
              "claims": { "type": "array", "minItems": 2 }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "value_kind": { "enum": ["exact", "range", "unknown"] },
              "resolution_kind": { "enum": ["single", "range", "unknown"] }
            }
          }
        },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "exact" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "single" } } } },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "range" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "range" } } } },
        { "if": { "type": "object", "properties": { "value_kind": { "const": "unknown" } } }, "then": { "type": "object", "properties": { "resolution_kind": { "const": "unknown" } } } }
      ]
    },
    "sourceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mid_expected_count", "mid_manifest_hash", "current_expected_count", "current_manifest_hash"],
      "properties": {
        "kind": { "enum": ["working_checkpoint", "final_mid_and_current"] },
        "mid_expected_count": { "type": "integer", "minimum": 0, "maximum": 40 },
        "mid_manifest_hash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] },
        "current_expected_count": { "type": "integer", "minimum": 0, "maximum": 40 },
        "current_manifest_hash": { "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "working_checkpoint" } } },
          "then": {
            "properties": {
              "mid_expected_count": { "const": 0 },
              "mid_manifest_hash": { "type": "null" },
              "current_expected_count": { "const": 0 },
              "current_manifest_hash": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "final_mid_and_current" } } },
          "then": {
            "properties": {
              "mid_expected_count": { "type": "integer", "minimum": 1 },
              "mid_manifest_hash": { "$ref": "#/$defs/digest" },
              "current_manifest_hash": { "$ref": "#/$defs/digest" }
            }
          }
        }
      ]
    },
    "semanticValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "number" },
        { "type": "boolean" },
        { "type": "null" },
        { "type": "array", "maxItems": 80, "items": { "$ref": "#/$defs/semanticValue" } },
        {
          "type": "object",
          "maxProperties": 80,
          "propertyNames": { "pattern": "^(?!.*(?:raw_transcript|transcript|prompt|provider_payload|provider_request|provider_response|sql|cas|lifecycle|database_id|db_id)).+$" },
          "additionalProperties": { "$ref": "#/$defs/semanticValue" }
        }
      ]
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_revision", "deletion_scope_digest", "deletion_scope_status", "retention_policy_version", "retention_status"],
      "properties": {
        "policy_revision": { "type": "string", "minLength": 1 },
        "deletion_scope_digest": { "$ref": "#/$defs/digest" },
        "deletion_scope_status": { "const": "active" },
        "retention_policy_version": { "type": "string", "minLength": 1 },
        "retention_status": { "const": "active" }
      }
    }
  }
}
