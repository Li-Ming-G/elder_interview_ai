{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.example/schemas/interview-director-context-v2.json",
  "title": "InterviewDirectorContextV2",
  "$comment": "P4C-01-CONTRACT formal membership/freeze surface. This schema is a contract artifact; it does not authorize runtime assembly or Director wiring.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_schema_version",
    "contract_version",
    "project_id",
    "current_session_id",
    "interview_state",
    "working_memory",
    "active_memory",
    "resumed_memory",
    "recent_transcript",
    "memory_candidates",
    "boundaries",
    "actual_asked",
    "displayed",
    "question_bank",
    "current_presentation",
    "budget",
    "v1_compatibility",
    "freeze",
    "membership",
    "membership_digest",
    "context_digest"
  ],
  "properties": {
    "context_schema_version": { "const": "interview-director-context-v2" },
    "contract_version": { "const": "p4-context-freeze-v1" },
    "project_id": { "$ref": "#/$defs/uuid" },
    "current_session_id": { "$ref": "#/$defs/uuid" },
    "interview_state": { "$ref": "#/$defs/interviewState" },
    "working_memory": { "$ref": "#/$defs/workingMemorySection" },
    "active_memory": {
      "$ref": "#/$defs/activeMemorySection",
      "description": "The current thread domain. It is separate from resumed_memory even when both are empty."
    },
    "resumed_memory": {
      "$ref": "#/$defs/resumedMemorySection",
      "description": "A resumed/continuation thread domain. It is never folded into active_memory."
    },
    "recent_transcript": {
      "type": "array",
      "items": { "$ref": "#/$defs/transcriptSegment" }
    },
    "memory_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/p3Candidate" }
    },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "#/$defs/controlBoundary" }
    },
    "actual_asked": {
      "type": "array",
      "items": { "$ref": "#/$defs/actualQuestion" }
    },
    "displayed": {
      "type": "array",
      "items": { "$ref": "#/$defs/displayedQuestion" }
    },
    "question_bank": {
      "type": "array",
      "items": { "$ref": "#/$defs/questionBankReference" }
    },
    "current_presentation": {
      "oneOf": [
        { "$ref": "#/$defs/presentation" },
        { "type": "null" }
      ]
    },
    "budget": { "$ref": "#/$defs/budgetSeam" },
    "v1_compatibility": { "$ref": "#/$defs/v1Compatibility" },
    "freeze": { "$ref": "#/$defs/freezeMetadata" },
    "membership": { "$ref": "#/$defs/membershipFreeze" },
    "membership_digest": { "$ref": "#/$defs/digest" },
    "context_digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "interviewState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["journey_stage", "journey_reason_codes", "goal"],
      "properties": {
        "journey_stage": { "enum": ["rapport", "life_outline", "story_depth"] },
        "journey_reason_codes": {
          "type": "array",
          "maxItems": 12,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "goal": { "type": "string", "minLength": 1, "maxLength": 300 }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "text_revision",
        "speaker_role_revision",
        "effective_text_digest",
        "order"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/uuid" },
        "text_revision": { "type": "integer", "minimum": 0 },
        "speaker_role_revision": { "type": "integer", "minimum": 0 },
        "effective_text_digest": { "$ref": "#/$defs/digest" },
        "order": { "type": "integer", "minimum": 0 }
      }
    },
    "workingMemoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "canonical_key",
        "memory_type",
        "value",
        "value_kind",
        "layer",
        "status",
        "revision",
        "thread_id",
        "evidence"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "canonical_key": { "type": "string", "minLength": 1, "maxLength": 240 },
        "memory_type": { "type": "string", "minLength": 1 },
        "value": {},
        "value_kind": { "enum": ["exact", "range", "unknown"] },
        "layer": { "const": "working" },
        "status": { "enum": ["current", "uncertain", "disputed"] },
        "revision": { "type": "integer", "minimum": 1 },
        "thread_id": { "$ref": "#/$defs/uuid" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    },
    "workingMemorySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "items"],
      "properties": {
        "source": { "const": "p1-working-direct" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/workingMemoryItem" } }
      }
    },
    "threadMemoryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "resolution_authority_id",
        "revision_id",
        "revision_no",
        "source_level",
        "semantic_kind",
        "semantic_status",
        "safe_content",
        "membership_digest",
        "input_order"
      ],
      "properties": {
        "memory_id": { "$ref": "#/$defs/uuid" },
        "resolution_authority_id": { "$ref": "#/$defs/uuid" },
        "revision_id": { "$ref": "#/$defs/uuid" },
        "revision_no": { "type": "integer", "minimum": 1 },
        "source_level": { "enum": ["mid", "long"] },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "safe_content": { "type": "string", "minLength": 1 },
        "membership_digest": { "$ref": "#/$defs/digest" },
        "input_order": { "type": "integer", "minimum": 0 }
      }
    },
    "threadMemorySection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "thread_id", "thread_revision", "source_session_id", "items"],
      "properties": {
        "state": { "enum": ["active", "resumed", "empty"] },
        "thread_id": { "type": ["string", "null"], "format": "uuid" },
        "thread_revision": { "type": ["integer", "null"], "minimum": 1 },
        "source_session_id": { "type": ["string", "null"], "format": "uuid" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/threadMemoryItem" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "empty" } } },
          "then": {
            "properties": {
              "thread_id": { "type": "null" },
              "thread_revision": { "type": "null" },
              "source_session_id": { "type": "null" },
              "items": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "state": { "enum": ["active", "resumed"] } } },
          "then": {
            "properties": {
              "thread_id": { "$ref": "#/$defs/uuid" },
              "thread_revision": { "type": "integer", "minimum": 1 },
              "source_session_id": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      ]
    },
    "activeMemorySection": {
      "allOf": [
        { "$ref": "#/$defs/threadMemorySection" },
        { "properties": { "state": { "enum": ["active", "empty"] } } }
      ],
      "$comment": "Only active or empty is valid in the active_memory slot."
    },
    "resumedMemorySection": {
      "allOf": [
        { "$ref": "#/$defs/threadMemorySection" },
        { "properties": { "state": { "enum": ["resumed", "empty"] } } }
      ],
      "$comment": "Only resumed or empty is valid in the resumed_memory slot."
    },
    "transcriptSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "session_id",
        "start_ms",
        "text",
        "trusted_role",
        "content_kind",
        "text_revision",
        "speaker_role_revision",
        "effective_text_digest"
      ],
      "properties": {
        "segment_id": { "$ref": "#/$defs/uuid" },
        "session_id": { "$ref": "#/$defs/uuid" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "trusted_role": { "enum": ["elder", "interviewer"] },
        "content_kind": { "const": "conversation_final" },
        "text_revision": { "type": "integer", "minimum": 0 },
        "speaker_role_revision": { "type": "integer", "minimum": 0 },
        "effective_text_digest": { "$ref": "#/$defs/digest" }
      }
    },
    "p3Candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "resolution_authority_id",
        "revision_id",
        "source_level",
        "semantic_kind",
        "semantic_status",
        "safe_content",
        "retrieval_sources",
        "embedding_score",
        "graph_distance",
        "rank"
      ],
      "$comment": "Byte/field shape intentionally mirrors memory-p3-retrieval-v1 candidate.",
      "properties": {
        "memory_id": { "$ref": "#/$defs/uuid" },
        "resolution_authority_id": { "$ref": "#/$defs/uuid" },
        "revision_id": { "$ref": "#/$defs/uuid" },
        "revision_no": { "type": "integer", "minimum": 1 },
        "source_level": { "enum": ["mid", "long"] },
        "semantic_kind": { "enum": ["episode", "fact"] },
        "semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "safe_content": { "type": "string", "minLength": 1 },
        "retrieval_sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["embedding", "graph"] }
        },
        "embedding_score": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "graph_distance": { "type": ["integer", "null"], "minimum": 0 },
        "rank": { "type": "integer", "minimum": 0 }
      }
    },
    "controlBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "code", "abstract_scope", "status", "revision", "content_policy"],
      "$comment": "Boundary is intentionally control-only. No source text, evidence, or raw marker payload is permitted.",
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "code": { "type": "string", "minLength": 1, "maxLength": 50 },
        "abstract_scope": { "type": "string", "minLength": 1, "maxLength": 160 },
        "status": { "const": "active" },
        "revision": { "type": "integer", "minimum": 1 },
        "content_policy": { "const": "control-only-no-source-text" }
      }
    },
    "actualQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_question_id", "text", "source", "evidence_segment_ids"],
      "properties": {
        "actual_question_id": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "source": { "enum": ["interviewer_spontaneous", "matched_system_suggestion"] },
        "evidence_segment_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "displayedQuestion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "text", "display_sequence", "outcome", "actual_question_id"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "display_sequence": { "type": "integer", "minimum": 1 },
        "outcome": { "enum": ["actual_asked", "explicitly_replaced", "not_observed", "unjudged"] },
        "actual_question_id": { "type": ["string", "null"], "format": "uuid" }
      }
    },
    "questionBankReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_bank_item_id",
        "bank",
        "topic",
        "question_text",
        "purpose",
        "sensitivity",
        "bank_version"
      ],
      "properties": {
        "question_bank_item_id": { "$ref": "#/$defs/uuid" },
        "bank": { "enum": ["basic", "deep"] },
        "topic": { "type": "string", "minLength": 1, "maxLength": 80 },
        "question_text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sensitivity": { "enum": ["low", "medium", "high"] },
        "bank_version": { "type": "string", "minLength": 1 }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "text", "display_sequence"],
      "properties": {
        "snapshot_id": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "display_sequence": { "type": "integer", "minimum": 1 }
      }
    },
    "budgetSeam": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Opaque seam only. P4C-01 does not define priority, clipping, or numeric budget behavior.",
      "required": ["config_ref", "policy_version"],
      "properties": {
        "config_ref": { "type": "string", "minLength": 1 },
        "policy_version": { "type": "string", "minLength": 1 }
      }
    },
    "v1Compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "schema_id", "projection_fields"],
      "properties": {
        "mode": { "const": "projection-only" },
        "schema_id": { "const": "interview-director-context-v1" },
        "projection_fields": {
          "type": "array",
          "const": [
            "current_presentation",
            "interview_state",
            "recent_transcript",
            "actual_asked",
            "recently_displayed",
            "bank_references",
            "boundaries"
          ]
        }
      }
    },
    "freezeMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeze_schema_version",
        "source_contracts",
        "scope",
        "required_sections",
        "deterministic_ordering",
        "budget_config_ref",
        "policy_revision"
      ],
      "properties": {
        "freeze_schema_version": { "const": "p4-context-freeze-v1" },
        "source_contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["p3_retrieval", "v1_context", "p4_context"],
          "properties": {
            "p3_retrieval": { "const": "memory-p3-retrieval-v1" },
            "v1_context": { "const": "interview-director-context-v1" },
            "p4_context": { "const": "p4-context-freeze-v1" }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["project_id", "current_session_id", "active_thread_id", "resumed_thread_id"],
          "properties": {
            "project_id": { "$ref": "#/$defs/uuid" },
            "current_session_id": { "$ref": "#/$defs/uuid" },
            "active_thread_id": { "type": ["string", "null"], "format": "uuid" },
            "resumed_thread_id": { "type": ["string", "null"], "format": "uuid" }
          }
        },
        "required_sections": {
          "type": "array",
          "const": [
            "interview_state",
            "working_memory",
            "active_memory",
            "resumed_memory",
            "recent_transcript",
            "memory_candidates",
            "boundaries",
            "actual_asked",
            "displayed",
            "question_bank",
            "current_presentation"
          ]
        },
        "deterministic_ordering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "tie_breakers"],
          "properties": {
            "algorithm": { "const": "p4-canonical-order-v1" },
            "tie_breakers": {
              "type": "array",
              "const": ["input_order", "source_id_lexicographic", "revision_ascending"]
            }
          }
        },
        "budget_config_ref": { "type": "string", "minLength": 1 },
        "policy_revision": { "type": "string", "minLength": 1 }
      }
    },
    "membershipEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "section",
        "source_type",
        "source_id",
        "source_revision",
        "content_digest",
        "membership_digest",
        "input_order"
      ],
      "properties": {
        "section": { "type": "string", "minLength": 1 },
        "source_type": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string", "minLength": 1 },
        "source_revision": { "type": ["integer", "null"], "minimum": 0 },
        "content_digest": { "$ref": "#/$defs/digest" },
        "membership_digest": { "$ref": "#/$defs/digest" },
        "input_order": { "type": "integer", "minimum": 0 }
      }
    },
    "sectionMembership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "source_bearing", "expected_member_count", "entries"],
      "properties": {
        "section": { "type": "string" },
        "source_bearing": { "const": true },
        "expected_member_count": { "type": "integer", "minimum": 0 },
        "entries": {
          "type": "array",
          "items": { "$ref": "#/$defs/membershipEntry" }
        }
      }
    },
    "interviewStateMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "interview_state" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "interview_state" }, "source_type": { "const": "interview_state" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "workingMemoryMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "working_memory" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "working_memory" }, "source_type": { "const": "working_memory" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "activeMemoryMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "active_memory" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "active_memory" }, "source_type": { "const": "memory_thread" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "resumedMemoryMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "resumed_memory" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "resumed_memory" }, "source_type": { "const": "memory_thread" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "recentTranscriptMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "recent_transcript" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "recent_transcript" }, "source_type": { "const": "transcript_segment" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "candidateMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "memory_candidates" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "memory_candidates" }, "source_type": { "const": "memory_candidate" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "boundaryMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "boundaries" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "boundaries" }, "source_type": { "const": "boundary_control" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "actualQuestionMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "actual_asked" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "actual_asked" }, "source_type": { "const": "actual_question" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "displayedMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "displayed" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "displayed" }, "source_type": { "const": "display_snapshot" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "questionBankMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "question_bank" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "question_bank" }, "source_type": { "const": "question_bank_item" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "presentationMembership": {
      "allOf": [
        { "$ref": "#/$defs/sectionMembership" },
        {
          "properties": {
            "section": { "const": "current_presentation" },
            "entries": {
              "items": {
                "allOf": [
                  { "$ref": "#/$defs/membershipEntry" },
                  { "properties": { "section": { "const": "current_presentation" }, "source_type": { "const": "presentation" } } }
                ]
              }
            }
          }
        }
      ]
    },
    "membershipFreeze": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Exactly one ordered section manifest is required for every required section. Cross-field source completeness, count, revision, and digest parity are fail-closed semantic checks for the future assembly validator.",
      "required": ["membership_schema_version", "scope", "sections"],
      "properties": {
