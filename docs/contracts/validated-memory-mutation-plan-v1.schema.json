{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/validated-memory-mutation-plan-v1.schema.json",
  "title": "Validated Memory Mutation Plan V1 (Transient Only)",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_schema_version", "source_manifest_hash", "proposal_digest", "plan_digest", "entries"],
  "properties": {
    "plan_schema_version": { "const": "validated-memory-mutation-plan-v1" },
    "source_manifest_hash": { "$ref": "#/$defs/digest" },
    "proposal_digest": { "$ref": "#/$defs/digest" },
    "plan_digest": { "$ref": "#/$defs/digest" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "description": "Pure semantic validation requires proposal_id and target semantic slot to be projection-wide unique and permits at most one write entry for each existing target_authority_ref.resolution_id.",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "sourceRef": { "type": "string", "pattern": "^src:[A-Za-z0-9._:-]{1,120}$" },
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["proposal_id", "source_member_ref_ids", "target_kind", "target_authority_ref", "proposed_state_digest", "claim_evidence_manifest_hash"],
      "properties": {
        "proposal_id": { "type": "string", "pattern": "^proposal:[A-Za-z0-9._:-]{1,120}$" },
        "source_member_ref_ids": { "type": "array", "minItems": 1, "maxItems": 40, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRef" } },
        "target_kind": { "enum": ["new_slot", "existing_slot"] },
        "target_authority_ref": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object", "additionalProperties": false,
              "required": ["resolution_id", "expected_revision"],
              "properties": {
                "resolution_id": { "$ref": "#/$defs/uuid" },
                "expected_revision": { "type": "integer", "minimum": 1 }
              }
            }
          ]
        },
        "proposed_state_digest": { "$ref": "#/$defs/digest" },
        "claim_evidence_manifest_hash": { "$ref": "#/$defs/digest" }
      },
      "allOf": [
        { "if": { "properties": { "target_kind": { "const": "new_slot" } } }, "then": { "properties": { "target_authority_ref": { "type": "null" } } } },
        { "if": { "properties": { "target_kind": { "const": "existing_slot" } } }, "then": { "properties": { "target_authority_ref": { "type": "object" } } } }
      ]
    }
  }
}
