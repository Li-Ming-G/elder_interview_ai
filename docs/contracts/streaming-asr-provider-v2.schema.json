{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.example/contracts/streaming-asr-provider-v2.schema.json",
  "title": "StreamingAsrAdapterV2 provider-neutral contract",
  "description": "FORMAL. Contract for DEV-ASR-PROVIDER-001. It replaces the v1 accept(frame)->results/drain()->void runtime seam; v1 must not remain as a production truth source.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "lifecycle", "namespace", "audio", "result", "drain", "session_capture_completeness", "errors"],
  "properties": {
    "contract_version": { "const": "streaming-asr-provider-v2" },
    "lifecycle": {
      "description": "Attempt-scoped lifecycle. It never proves session/capture transcription completeness.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "state", "attempt_id"],
      "properties": {
        "scope": { "const": "attempt" },
        "state": { "enum": ["connect", "ready", "streaming", "stopping", "draining", "drained", "degraded", "not_started", "failed"] },
        "attempt_id": { "type": "string", "format": "uuid" }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "provider_namespace_id", "provider_request_id", "speaker_stream_id"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "provider_namespace_id": { "type": "string", "minLength": 1 },
        "provider_request_id": { "type": "string", "minLength": 1 },
        "speaker_stream_id": { "type": "string", "format": "uuid" }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "sample_rate_hz", "channels", "frame_duration_ms", "accepted_through_sequence"],
      "properties": {
        "encoding": { "const": "pcm_s16le" },
        "sample_rate_hz": { "const": 16000 },
        "channels": { "const": 1 },
        "frame_duration_ms": { "const": 100 },
        "accepted_through_sequence": { "type": "integer", "minimum": -1 },
        "sent_through_sequence": { "type": "integer", "minimum": -1 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_id", "provider_namespace_id", "provider_request_id", "speaker_stream_id", "ingest_key", "kind", "text", "start_ms", "end_ms", "speaker_provider_id"],
      "properties": {
        "attempt_id": { "type": "string", "format": "uuid" },
        "provider_namespace_id": { "type": "string", "minLength": 1 },
        "provider_request_id": { "type": "string", "minLength": 1 },
        "speaker_stream_id": { "type": "string", "format": "uuid" },
        "ingest_key": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["interim", "final"] },
        "text": { "type": "string" },
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 },
        "speaker_provider_id": { "type": ["string", "null"] }
      }
    },
    "drain": {
      "title": "AttemptDrainReceipt",
      "description": "Receipt for one attempt/voice only. Success cannot clear an earlier session/capture gap and cannot by itself project finalization to drained.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "attempt_id", "provider_namespace_id", "provider_request_id", "speaker_stream_id", "provider_final_observed", "accepted_through_sequence", "terminal_through_sequence", "results_ingested", "completed_at"],
      "properties": {
        "scope": { "const": "attempt" },
        "attempt_id": { "type": "string", "format": "uuid" },
        "provider_namespace_id": { "type": "string", "minLength": 1 },
        "provider_request_id": { "type": "string", "minLength": 1 },
        "speaker_stream_id": { "type": "string", "format": "uuid" },
        "provider_final_observed": { "const": true },
        "accepted_through_sequence": { "type": "integer", "minimum": -1 },
        "terminal_through_sequence": { "type": "integer", "minimum": -1 },
        "results_ingested": { "const": true },
        "completed_at": { "type": "string", "format": "date-time" }
      }
    },
    "session_capture_completeness": {
      "description": "Runtime session/capture aggregate across every provider attempt. known_unbackfilled_gap is sticky in this contract; only a future HARDEN-ASR-001 authority may define evidence-backed recomputation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "status", "sticky_degraded", "complete_capture_coverage_proven", "unbackfilled_gaps", "clear_authority"],
      "properties": {
        "scope": { "const": "session_capture" },
        "status": { "enum": ["no_known_gap", "known_unbackfilled_gap"] },
        "sticky_degraded": { "type": "boolean" },
        "complete_capture_coverage_proven": { "type": "boolean" },
        "unbackfilled_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/unbackfilledGap" }
        },
        "clear_authority": { "const": "HARDEN-ASR-001" }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "no_known_gap" },
            "sticky_degraded": { "const": false },
            "complete_capture_coverage_proven": { "const": true },
            "unbackfilled_gaps": { "maxItems": 0 }
          }
        },
        {
          "properties": {
            "status": { "const": "known_unbackfilled_gap" },
            "sticky_degraded": { "const": true },
            "complete_capture_coverage_proven": { "const": false },
            "unbackfilled_gaps": { "minItems": 1 }
          }
        }
      ]
    },
    "errors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "retryable", "safe_code"],
      "properties": {
        "category": { "enum": ["auth", "signature", "quota", "rate_limit", "engine", "audio", "network", "timeout", "provider", "cancelled", "protocol"] },
        "retryable": { "type": "boolean" },
        "safe_code": { "type": "string", "pattern": "^ASR_[A-Z0-9_]+$" }
      }
    }
  },
  "$defs": {
    "unbackfilledGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_attempt_id", "start_sequence", "end_sequence", "reason", "backfill_status"],
      "properties": {
        "source_attempt_id": { "type": ["string", "null"], "format": "uuid" },
        "start_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "end_sequence": { "type": ["integer", "null"], "minimum": 0 },
        "reason": {
          "enum": [
            "accepted_not_terminal",
            "capture_coverage_discontinuity",
            "ready_timeout_unaccounted_pcm",
            "drain_timeout_unaccounted_pcm",
            "cancelled_unaccounted_pcm",
            "provider_error_unaccounted_pcm",
            "evidence_lost"
          ]
        },
        "backfill_status": { "const": "unbackfilled" }
      }
    }
  }
}
