      { "name": "parent_field_copied_to_child", "parent_fields_present": true, "parent_sentinels_valid": true, "child_contains_parent_duplicates": true, "expected_valid": false },
      { "name": "missing_parent_decision_sentinel", "parent_fields_present": true, "parent_sentinels_valid": false, "child_contains_parent_duplicates": false, "expected_valid": false },
      { "name": "missing_required_parent_status", "parent_fields_present": false, "parent_sentinels_valid": true, "child_contains_parent_duplicates": false, "expected_valid": false }
    ]
