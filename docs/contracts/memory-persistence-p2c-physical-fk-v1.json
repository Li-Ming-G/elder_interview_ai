{
  "manifest_version": "memory-persistence-p2c-physical-fk-v1",
  "status": "PROPOSED / REVIEW",
  "scope": {
    "architecture_mapping": ["T5-T8/P2", "T18-T19/P6", "T0/Foundation-Observability"],
    "implementation_boundary": "contract-only; no Prisma/runtime/provider/data implementation",
    "p2b_accepted_artifacts_immutable": true,
    "p2c_predecessor_review_head": "0ea5f47"
  },
  "p2b_view_boundary": {
    "physical_fk_policy": "P2-B view references are projections over the physical rows below; view IDs never authorize a polymorphic bare target_id FK.",
    "view_references": [
      { "view": "resolution_authorities", "view_column": "resolution_id", "physical_authority": "memory_resolution_authority.authority_id", "is_physical_fk": false },
      { "view": "claim_authorities", "view_column": "claim_id", "physical_authority": "memory_claim.id", "is_physical_fk": false },
      { "view": "evidence_authorities", "view_column": "evidence_id", "physical_authority": "memory_evidence_authority.evidence_id", "is_physical_fk": false },
      { "view": "retention_roots", "view_column": "target_id", "physical_authority": "typed target selected by root_kind", "is_physical_fk": false },
      { "view": "checkpoint", "view_column": "source_p1_final_job_id", "physical_authority": "memory_evolution_checkpoint.source_p1_terminal_job_id + p2_producer_job_id", "is_physical_fk": false },
      { "view": "memory_trace", "view_column": "deletion_scope_digest", "physical_authority": "decision_trace_memory_semantic.deletion_scope_digest", "is_physical_fk": false }
    ]
  },
  "self_validation": {
    "physical_view_reference_rule": "for every p2b_view_boundary.view_references item with is_physical_fk=true, an exact from_table/from_columns/to_table/to_columns match must exist in foreign_keys; false means scalar/provenance consistency, never an FK",
    "digest_rule": "deletion_scope_digest is lowercase SHA-256, non-null on P2 freeze/Trace semantic/source-reference/job/checkpoint projections, and is checked by cross-table CAS; it is never classified as an FK",
    "typed_source_rule": "source reference rows must satisfy the closed source_kind domain CHECK and exactly one matching typed source column; all five typed columns are physically nullable and bare source_id is not an FK",
    "trace_placement_rule": "decision_outcome/director_invoked/status/stage/error_code/context_revision/stage_timings_json remain on decision_trace parent; decision_trace_memory_semantic must not duplicate them",
    "evidence_revision_owner_rule": "memory_evidence_authority.authority_revision is the only authority revision owner; memory_claim_evidence/memory_evidence_bridge may mirror the claim/evidence/revision tuple only for pair parity",
    "p2_string_policy_source_rule": "p2_policy_revision and p2_retention_policy_version exist only on memory_p2_job_projection as bounded VARCHAR; checkpoint legacy Int snapshots and independent contract identity columns cannot substitute or cast"
  },
  "authority_null_gate": {
    "column": "memory_resolution.authority_id",
    "legacy_column_nullable": true,
    "p2_new_write_check": "p2_write=true implies authority_id IS NOT NULL",
    "legacy_null_status": "unavailable",
    "reader_gate": "authority_id IS NULL makes the P2 reader/checkpoint/Long selector unavailable; it may not infer an authority"
  },
  "evidence_revision_ownership": {
    "owner_table": "memory_evidence_authority",
    "owner_column": "authority_revision",
    "owner_key": ["evidence_id", "authority_revision"],
    "pair_parity_tables": ["memory_claim_evidence", "memory_evidence_bridge"],
    "pair_parity_columns": ["claim_id", "evidence_id", "authority_revision"],
    "rule": "pair rows mirror authority_revision and must FK/CAS to the owner tuple; they never own or advance an evidence authority revision",
    "forbidden_revision_owners": ["memory_claim_evidence.authority_revision", "memory_evidence_bridge.authority_revision"],
    "semantic_cases": [
      { "name": "authority_row_owns_revision", "owner": "memory_evidence_authority.authority_revision", "pair_revision_matches_owner": true, "expected_valid": true },
      { "name": "bridge_mirrors_owner_revision", "owner": "memory_evidence_authority.authority_revision", "pair_table": "memory_evidence_bridge", "pair_revision_matches_owner": true, "expected_valid": true },
      { "name": "claim_link_declared_as_owner", "owner": "memory_claim_evidence.authority_revision", "pair_revision_matches_owner": true, "expected_valid": false },
      { "name": "bridge_revision_drift", "owner": "memory_evidence_authority.authority_revision", "pair_table": "memory_evidence_bridge", "pair_revision_matches_owner": false, "expected_valid": false }
    ]
  },
  "policy_source_contract": {
    "p2_string_policy_source": {
      "table": "memory_p2_job_projection",
      "columns": ["p2_policy_revision", "p2_retention_policy_version"],
      "physical_type": "bounded VARCHAR",
      "exclusive": true
    },
    "checkpoint_legacy_int_snapshot": {
      "table": "memory_evolution_checkpoint",
      "columns": ["ai_policy_revision", "retention_policy_version"],
      "physical_type": "INT",
      "meaning": "legacy AiJob snapshot only"
    },
    "checkpoint_contract_identity": {
      "table": "memory_evolution_checkpoint",
      "columns": ["p2_policy_contract_revision", "p2_retention_contract_version"],
      "meaning": "independent contract identity only; never a P2 policy string source"
    },
    "forbidden_checkpoint_columns": ["p2_policy_revision", "p2_retention_policy_version"],
    "forbidden_coercions": ["INT-to-VARCHAR cast", "contract identity substituted for policy revision", "contract identity substituted for retention policy version"],
    "semantic_cases": [
      { "name": "projection_varchar_policy", "source_table": "memory_p2_job_projection", "source_columns": ["p2_policy_revision", "p2_retention_policy_version"], "expected_valid": true },
      { "name": "checkpoint_legacy_int_snapshot", "source_table": "memory_evolution_checkpoint", "source_columns": ["ai_policy_revision", "retention_policy_version"], "expected_valid": true },
      { "name": "checkpoint_contract_identity", "source_table": "memory_evolution_checkpoint", "source_columns": ["p2_policy_contract_revision", "p2_retention_contract_version"], "expected_valid": true },
      { "name": "checkpoint_as_p2_string_source", "source_table": "memory_evolution_checkpoint", "source_columns": ["p2_policy_revision", "p2_retention_policy_version"], "expected_valid": false },
      { "name": "legacy_int_cast_as_p2_string", "source_table": "memory_evolution_checkpoint", "source_columns": ["ai_policy_revision", "retention_policy_version"], "coercion": "INT-to-VARCHAR cast", "expected_valid": false },
      { "name": "contract_identity_as_policy_source", "source_table": "memory_evolution_checkpoint", "source_columns": ["p2_policy_contract_revision", "p2_retention_contract_version"], "substitution": true, "expected_valid": false }
    ]
  },
  "source_reference_checks": [
    { "name": "decision_trace_memory_source_kind_domain_ck", "expression": "source_kind IN ('checkpoint', 'job', 'input_segment', 'evidence', 'resolution')" },
    { "name": "decision_trace_memory_source_kind_checkpoint_ck", "expression": "source_kind <> 'checkpoint' OR (source_checkpoint_id IS NOT NULL AND source_job_id IS NULL)" },
    { "name": "decision_trace_memory_source_kind_job_ck", "expression": "source_kind <> 'job' OR (source_job_id IS NOT NULL AND source_checkpoint_id IS NULL)" },
    { "name": "decision_trace_memory_source_kind_input_segment_ck", "expression": "source_kind <> 'input_segment' OR ai_job_input_segment_id IS NOT NULL" },
    { "name": "decision_trace_memory_source_kind_evidence_ck", "expression": "source_kind <> 'evidence' OR evidence_id IS NOT NULL" },
    { "name": "decision_trace_memory_source_kind_resolution_ck", "expression": "source_kind <> 'resolution' OR resolution_authority_id IS NOT NULL" },
    { "name": "decision_trace_memory_source_exactly_one_typed_ref_ck", "expression": "num_nonnulls(source_checkpoint_id, source_job_id, ai_job_input_segment_id, evidence_id, resolution_authority_id) = 1" }
  ],
  "source_reference_semantic_cases": [
    { "name": "checkpoint_only", "source_kind": "checkpoint", "non_null_typed_refs": ["source_checkpoint_id"], "required_columns_present": true, "expected_valid": true },
    { "name": "job_only", "source_kind": "job", "non_null_typed_refs": ["source_job_id"], "required_columns_present": true, "expected_valid": true },
    { "name": "input_segment_only", "source_kind": "input_segment", "non_null_typed_refs": ["ai_job_input_segment_id"], "required_columns_present": true, "expected_valid": true },
    { "name": "evidence_only", "source_kind": "evidence", "non_null_typed_refs": ["evidence_id"], "required_columns_present": true, "expected_valid": true },
    { "name": "resolution_only", "source_kind": "resolution", "non_null_typed_refs": ["resolution_authority_id"], "required_columns_present": true, "expected_valid": true },
    { "name": "zero_typed_refs", "source_kind": "job", "non_null_typed_refs": [], "required_columns_present": true, "expected_valid": false },
    { "name": "multiple_typed_refs", "source_kind": "checkpoint", "non_null_typed_refs": ["source_checkpoint_id", "source_job_id"], "required_columns_present": true, "expected_valid": false },
    { "name": "source_kind_mismatch", "source_kind": "job", "non_null_typed_refs": ["source_checkpoint_id"], "required_columns_present": true, "expected_valid": false },
    { "name": "missing_required_trace_id", "source_kind": "input_segment", "non_null_typed_refs": ["ai_job_input_segment_id"], "required_columns_present": false, "expected_valid": false },
    { "name": "unknown_source_kind", "source_kind": "unknown", "non_null_typed_refs": ["source_job_id"], "required_columns_present": true, "expected_valid": false }
  ],
  "decision_trace_parent_columns": {
    "table": "decision_trace",
