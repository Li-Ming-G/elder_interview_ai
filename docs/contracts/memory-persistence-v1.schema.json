{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/memory-persistence-v1.schema.json",
  "title": "Memory Persistence P2-B Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "scope", "policy", "checkpoint", "checkpoint_members", "claim_authorities", "resolution_authorities", "layer_identities", "layer_revisions", "revision_members", "mid_manifest", "long_projection", "jobs", "retention_roots", "migration", "foreign_keys", "evidence_authorities", "evidence_bridge", "trace_authorities"],
  "properties": {
    "contract_version": { "const": "memory-persistence-v1" },
    "scope": { "$ref": "#/$defs/scope" },
    "policy": { "$ref": "#/$defs/policy" },
    "checkpoint": { "$ref": "#/$defs/checkpoint" },
    "checkpoint_members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/checkpointMember" } },
    "claim_authorities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/claimAuthority" } },
    "resolution_authorities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resolutionAuthority" } },
    "layer_identities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/identity" } },
    "layer_revisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/revision" } },
    "revision_members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } },
    "mid_manifest": { "$ref": "#/$defs/midManifest" },
    "long_projection": { "anyOf": [{ "$ref": "#/$defs/longProjection" }, { "type": "null" }] },
    "jobs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/job" } },
    "retention_roots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/retentionRoot" } },
    "migration": { "$ref": "#/$defs/migration" },
    "foreign_keys": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/foreignKey" } },
    "evidence_authorities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceAuthority" } },
    "evidence_bridge": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidenceBridge" } },
    "trace_authorities": { "type": "array", "items": { "$ref": "#/$defs/traceAuthority" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "dateTime": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": { "type": "object", "additionalProperties": false, "required": ["project_id", "source_session_id", "source_session_ids"], "properties": { "project_id": { "$ref": "#/$defs/uuid" }, "source_session_id": { "$ref": "#/$defs/uuid" }, "source_session_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } } } },
    "policy": { "type": "object", "additionalProperties": false, "required": ["policy_revision", "deletion_scope_digest", "deletion_scope_status", "retention_policy_version", "retention_status"], "properties": { "policy_revision": { "type": "string", "minLength": 1 }, "deletion_scope_digest": { "$ref": "#/$defs/digest" }, "deletion_scope_status": { "enum": ["active", "hidden", "detached", "purging", "purged", "cleanup_failed"] }, "retention_policy_version": { "type": "string", "minLength": 1 }, "retention_status": { "enum": ["active", "hidden", "detached", "expired", "purging", "purged", "cleanup_failed"] } } },
    "checkpoint": { "type": "object", "additionalProperties": false, "required": ["checkpoint_id", "root_identity", "project_id", "source_session_id", "expected_member_count", "member_manifest_hash", "manifest_algorithm_version", "source_p1_final_job_id", "source_p1_final_status", "policy_revision", "retention_policy_version", "lifecycle_status", "immutable_at"], "properties": { "checkpoint_id": { "$ref": "#/$defs/uuid" }, "root_identity": { "$ref": "#/$defs/digest" }, "project_id": { "$ref": "#/$defs/uuid" }, "source_session_id": { "$ref": "#/$defs/uuid" }, "expected_member_count": { "type": "integer", "minimum": 1 }, "member_manifest_hash": { "$ref": "#/$defs/digest" }, "manifest_algorithm_version": { "const": "memory-evolution-canonical-v1" }, "source_p1_final_job_id": { "$ref": "#/$defs/uuid" }, "source_p1_final_status": { "const": "succeeded" }, "policy_revision": { "type": "string", "minLength": 1 }, "retention_policy_version": { "type": "string", "minLength": 1 }, "lifecycle_status": { "enum": ["committed", "hidden", "detached", "purging", "purged", "cleanup_failed"] }, "immutable_at": { "$ref": "#/$defs/dateTime" } } },
    "checkpointMember": { "type": "object", "additionalProperties": false, "required": ["resolution_id", "resolution_revision", "semantic_status", "claim_count", "boundary_status", "membership_digest", "input_order"], "properties": { "resolution_id": { "$ref": "#/$defs/uuid" }, "resolution_revision": { "type": "integer", "minimum": 1 }, "semantic_status": { "enum": ["current", "uncertain", "disputed"] }, "claim_count": { "type": "integer", "minimum": 1 }, "boundary_status": { "enum": ["none", "active", "revoked", "superseded"] }, "membership_digest": { "$ref": "#/$defs/digest" }, "input_order": { "type": "integer", "minimum": 0 } } },
    "claimAuthority": { "type": "object", "additionalProperties": false, "required": ["claim_id", "claim_revision", "resolution_id", "project_id", "source_session_id", "evidence_ids", "evidence_manifest_hash"], "properties": { "claim_id": { "$ref": "#/$defs/uuid" }, "claim_revision": { "type": "integer", "minimum": 1 }, "resolution_id": { "$ref": "#/$defs/uuid" }, "project_id": { "$ref": "#/$defs/uuid" }, "source_session_id": { "$ref": "#/$defs/uuid" }, "evidence_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "evidence_manifest_hash": { "$ref": "#/$defs/digest" } } },
    "resolutionAuthority": { "type": "object", "additionalProperties": false, "required": ["resolution_id", "resolution_revision", "project_id", "source_session_id", "semantic_status", "boundary_status", "claim_ids", "membership_digest"], "properties": { "resolution_id": { "$ref": "#/$defs/uuid" }, "resolution_revision": { "type": "integer", "minimum": 1 }, "project_id": { "$ref": "#/$defs/uuid" }, "source_session_id": { "$ref": "#/$defs/uuid" }, "semantic_status": { "enum": ["current", "uncertain", "disputed"] }, "boundary_status": { "enum": ["none", "active", "revoked", "superseded"] }, "claim_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "membership_digest": { "$ref": "#/$defs/digest" } } },
    "identity": { "type": "object", "additionalProperties": false, "required": ["layer_identity_id", "project_id", "origin_session_id", "origin_thread_id", "origin_resolution_id", "identity_key_digest", "created_at"], "properties": { "layer_identity_id": { "$ref": "#/$defs/uuid" }, "project_id": { "$ref": "#/$defs/uuid" }, "origin_session_id": { "$ref": "#/$defs/uuid" }, "origin_thread_id": { "$ref": "#/$defs/uuid" }, "origin_resolution_id": { "$ref": "#/$defs/uuid" }, "identity_key_digest": { "$ref": "#/$defs/digest" }, "created_at": { "$ref": "#/$defs/dateTime" } } },
    "revision": { "type": "object", "additionalProperties": false, "required": ["layer_revision_id", "layer_identity_id", "layer", "revision_no", "lifecycle_status", "project_id", "source_session_id", "source_checkpoint_id", "source_job_id", "resolution_id", "resolution_revision", "semantic_status", "predecessor_layer_revision_id", "expected_member_count", "member_manifest_hash", "manifest_algorithm_version", "created_at"], "properties": { "layer_revision_id": { "$ref": "#/$defs/uuid" }, "layer_identity_id": { "$ref": "#/$defs/uuid" }, "layer": { "enum": ["mid", "long"] }, "revision_no": { "type": "integer", "minimum": 1 }, "lifecycle_status": { "enum": ["pending", "current", "superseded", "hidden", "detached", "purging", "purged", "cleanup_failed"] }, "project_id": { "$ref": "#/$defs/uuid" }, "source_session_id": { "$ref": "#/$defs/uuid" }, "source_checkpoint_id": { "$ref": "#/$defs/uuid" }, "source_job_id": { "$ref": "#/$defs/uuid" }, "resolution_id": { "$ref": "#/$defs/uuid" }, "resolution_revision": { "type": "integer", "minimum": 1 }, "semantic_status": { "enum": ["current", "uncertain", "disputed"] }, "predecessor_layer_revision_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }, "expected_member_count": { "type": "integer", "minimum": 1 }, "member_manifest_hash": { "$ref": "#/$defs/digest" }, "manifest_algorithm_version": { "const": "memory-evolution-canonical-v1" }, "created_at": { "$ref": "#/$defs/dateTime" } } },
    "member": { "type": "object", "additionalProperties": false, "required": ["layer_revision_id", "memory_claim_id", "claim_revision", "role", "input_order", "evidence_membership_digest"], "properties": { "layer_revision_id": { "$ref": "#/$defs/uuid" }, "memory_claim_id": { "$ref": "#/$defs/uuid" }, "claim_revision": { "type": "integer", "minimum": 1 }, "role": { "enum": ["primary", "supporting", "conflicting", "superseded"] }, "input_order": { "type": "integer", "minimum": 0 }, "evidence_membership_digest": { "$ref": "#/$defs/digest" } } },
    "midManifestRef": { "type": "object", "additionalProperties": false, "required": ["layer_revision_id", "layer_identity_id", "resolution_id", "resolution_revision", "semantic_status", "membership_digest", "input_order", "source_session_id"], "properties": { "layer_revision_id": { "$ref": "#/$defs/uuid" }, "layer_identity_id": { "$ref": "#/$defs/uuid" }, "resolution_id": { "$ref": "#/$defs/uuid" }, "resolution_revision": { "type": "integer", "minimum": 1 }, "semantic_status": { "enum": ["current", "uncertain", "disputed"] }, "membership_digest": { "$ref": "#/$defs/digest" }, "input_order": { "type": "integer", "minimum": 0 }, "source_session_id": { "$ref": "#/$defs/uuid" } } },
    "midManifest": { "type": "object", "additionalProperties": false, "required": ["expected_revision_count", "revision_manifest_hash", "manifest_algorithm_version", "source_session_ids", "revisions"], "properties": { "expected_revision_count": { "type": "integer", "minimum": 1 }, "revision_manifest_hash": { "$ref": "#/$defs/digest" }, "manifest_algorithm_version": { "const": "memory-evolution-canonical-v1" }, "source_session_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "revisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/midManifestRef" } } } },
    "longProjection": { "type": "object", "additionalProperties": false, "required": ["job_id", "target_layer_revision_id", "source_session_ids", "source_mid_revision_ids", "source_mid_manifest_hash"], "properties": { "job_id": { "$ref": "#/$defs/uuid" }, "target_layer_revision_id": { "$ref": "#/$defs/uuid" }, "source_session_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "source_mid_revision_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/uuid" } }, "source_mid_manifest_hash": { "$ref": "#/$defs/digest" } } },
    "job": { "type": "object", "additionalProperties": false, "required": ["job_id", "trigger_identity_hash", "job_type", "status", "attempt_no", "retry_of_job_id", "request_identity_hash", "policy_revision", "source_checkpoint_id", "target_layer_revision_id", "source_revision_digest", "target_revision_digest"], "properties": { "job_id": { "$ref": "#/$defs/uuid" }, "trigger_identity_hash": { "$ref": "#/$defs/digest" }, "job_type": { "enum": ["mid_online", "mid_final", "long_session_end"] }, "status": { "enum": ["pending", "running", "succeeded", "failed", "cancelled", "unavailable"] }, "attempt_no": { "type": "integer", "minimum": 1 }, "retry_of_job_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] }, "request_identity_hash": { "$ref": "#/$defs/digest" }, "policy_revision": { "type": "string", "minLength": 1 }, "source_checkpoint_id": { "$ref": "#/$defs/uuid" }, "target_layer_revision_id": { "$ref": "#/$defs/uuid" }, "source_revision_digest": { "$ref": "#/$defs/digest" }, "target_revision_digest": { "$ref": "#/$defs/digest" } } },
    "retentionRoot": { "type": "object", "additionalProperties": false, "required": ["retention_root_id", "root_kind", "target_id", "status", "expires_at", "policy_revision", "deletion_scope_digest", "cleanup_job_id"], "properties": { "retention_root_id": { "$ref": "#/$defs/uuid" }, "root_kind": { "enum": ["checkpoint", "layer_revision", "job", "trace"] }, "target_id": { "$ref": "#/$defs/uuid" }, "status": { "enum": ["active", "hidden", "detached", "expired", "purging", "purged", "cleanup_failed"] }, "expires_at": { "$ref": "#/$defs/dateTime" }, "policy_revision": { "type": "string", "minLength": 1 }, "deletion_scope_digest": { "$ref": "#/$defs/digest" }, "cleanup_job_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] } } },
    "migration": { "type": "object", "additionalProperties": false, "required": ["schema_version", "mode", "manifest_id", "source_version", "target_version", "status"], "properties": { "schema_version": { "const": "memory-persistence-v1" }, "mode": { "enum": ["fresh", "upgrade"] }, "manifest_id": { "$ref": "#/$defs/uuid" }, "source_version": { "type": "string", "minLength": 1 }, "target_version": { "const": "memory-persistence-v1" }, "status": { "enum": ["ready", "upgrading", "completed", "interrupted", "unavailable"] } } },
    "foreignKey": { "type": "object", "additionalProperties": false, "required": ["name", "from", "to", "nullable", "on_delete"], "properties": { "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,80}$" }, "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 }, "nullable": { "type": "boolean" }, "on_delete": { "enum": ["RESTRICT", "SET_NULL"] } } },
    "evidenceAuthority": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "source_kind", "source_id", "source_revision", "membership_digest", "project_id", "session_id"], "properties": { "evidence_id": { "$ref": "#/$defs/uuid" }, "source_kind": { "enum": ["transcript_segment", "question_evidence", "decision_trace"] }, "source_id": { "$ref": "#/$defs/uuid" }, "source_revision": { "type": "integer", "minimum": 1 }, "membership_digest": { "$ref": "#/$defs/digest" }, "project_id": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" } } },
    "evidenceBridge": { "type": "object", "additionalProperties": false, "required": ["evidence_id", "source_kind", "source_id", "source_revision", "membership_digest", "scope_project_id", "scope_session_id"], "properties": { "evidence_id": { "$ref": "#/$defs/uuid" }, "source_kind": { "enum": ["transcript_segment", "question_evidence", "decision_trace"] }, "source_id": { "$ref": "#/$defs/uuid" }, "source_revision": { "type": "integer", "minimum": 1 }, "membership_digest": { "$ref": "#/$defs/digest" }, "scope_project_id": { "$ref": "#/$defs/uuid" }, "scope_session_id": { "$ref": "#/$defs/uuid" } } },
    "traceAuthority": { "type": "object", "additionalProperties": false, "required": ["trace_id", "project_id", "session_id"], "properties": { "trace_id": { "$ref": "#/$defs/uuid" }, "project_id": { "$ref": "#/$defs/uuid" }, "session_id": { "$ref": "#/$defs/uuid" } } }
  }
}
