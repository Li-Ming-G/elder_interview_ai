{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elder-interview.local/contracts/long-memory-consolidation-output-v1.schema.json",
  "title": "Long Memory Consolidation Output V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["output_schema_version", "long_job", "revision_candidates"],
  "properties": {
    "output_schema_version": { "const": "long-memory-consolidation-output-v1" },
    "long_job": { "$ref": "#/$defs/job" },
    "revision_candidates": { "type": "array", "items": { "$ref": "#/$defs/revision" } }
  },
  "$defs": {
    "uuid": { "type": "string", "format": "uuid" },
    "digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "terminal_status", "request_identity_hash", "attempt_no", "retry_of_job_id", "source_final_checkpoint_id", "source_mid_manifest_hash"],
      "properties": {
        "job_id": { "$ref": "#/$defs/uuid" },
        "terminal_status": { "enum": ["succeeded", "failed", "cancelled", "unavailable"] },
        "request_identity_hash": { "$ref": "#/$defs/digest" },
        "attempt_no": { "type": "integer", "minimum": 1 },
        "retry_of_job_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "source_final_checkpoint_id": { "$ref": "#/$defs/uuid" },
        "source_mid_manifest_hash": { "$ref": "#/$defs/digest" }
      }
    },
    "revision": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_key", "layer_identity_id", "target_layer", "lifecycle_status", "source_resolution_id", "source_resolution_revision", "source_semantic_status", "predecessor_layer_revision_id", "expected_member_count", "member_manifest_hash", "source_mid_revision_ids", "members"],
      "properties": {
        "candidate_key": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
        "layer_identity_id": { "$ref": "#/$defs/uuid" },
        "target_layer": { "const": "long" },
        "lifecycle_status": { "const": "current" },
        "source_resolution_id": { "$ref": "#/$defs/uuid" },
        "source_resolution_revision": { "type": "integer", "minimum": 1 },
        "source_semantic_status": { "enum": ["current", "uncertain", "disputed"] },
        "predecessor_layer_revision_id": { "anyOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }] },
        "expected_member_count": { "type": "integer", "minimum": 1 },
        "member_manifest_hash": { "$ref": "#/$defs/digest" },
        "source_mid_revision_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/uuid" } },
        "members": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/member" } }
      }
    },
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["memory_claim_id", "role", "input_order", "evidence_membership_digest"],
      "properties": {
        "memory_claim_id": { "$ref": "#/$defs/uuid" },
        "role": { "enum": ["primary", "supporting", "conflicting", "superseded"] },
        "input_order": { "type": "integer", "minimum": 0 },
        "evidence_membership_digest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
