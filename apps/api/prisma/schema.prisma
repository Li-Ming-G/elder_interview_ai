generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  interviewer
  admin
  data_admin
}

enum UserStatus {
  active
  disabled
}

enum AuditActorType {
  user
  system_operator
}

enum AuthThrottleKeyKind {
  identity_ip
  ip
}

enum ProjectStatus {
  draft
  ready
  active
  completed
  restricted
  deleted
}

enum AssignmentRole {
  interviewer
}

enum ConsentType {
  recording_transcription_ai
}

enum ConsentMethod {
  recorded_verbal
  electronic
  written
}

enum ConsentStatus {
  pending
  valid
  revoked
  expired
}

enum InterviewSessionStatus {
  created
  device_check
  recording
  reconnecting
  stopping
  processing
  completed
  interrupted
  failed
}

enum AudioPurpose {
  consent
  interview
}

enum AudioObjectStatus {
  initiated
  uploading
  complete
  failed
}

enum AudioChunkUploadStatus {
  pending
  uploading
  uploaded
  failed
  missing
}

model User {
  id                       String              @id @default(uuid()) @db.Uuid
  email                    String              @unique @db.VarChar(254)
  displayName              String              @map("display_name") @db.VarChar(120)
  passwordHash             String              @map("password_hash")
  role                     UserRole
  status                   UserStatus          @default(active)
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt               DateTime?           @map("disabled_at") @db.Timestamptz(3)
  sessions                 AuthSession[]
  auditLogs                AuditLog[]
  createdProjects          ElderProject[]      @relation("ProjectCreator")
  projectAssignments       ProjectAssignment[]
  explainedServiceTerms    ServiceTerm[]       @relation("ServiceTermExplainer")
  createdConsents          ConsentRecord[]     @relation("ConsentCreator")
  createdInterviewSessions InterviewSession[]  @relation("InterviewSessionCreator")
  idempotencyRecords       IdempotencyRecord[]
  createdAudioObjects      AudioObject[]       @relation("AudioObjectCreator")

  @@map("user")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(80)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@map("auth_session")
}

model AuthLoginThrottle {
  id              String              @id @default(uuid()) @db.Uuid
  keyHash         String              @map("key_hash") @db.Char(64)
  keyKind         AuthThrottleKeyKind @map("key_kind")
  windowStartedAt DateTime            @map("window_started_at") @db.Timestamptz(3)
  failureCount    Int                 @default(0) @map("failure_count")
  blockedUntil    DateTime?           @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyHash, keyKind])
  @@map("auth_login_throttle")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  actorReference String?        @map("actor_reference") @db.VarChar(200)
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(80)
  entityId       String?        @map("entity_id") @db.Uuid
  requestId      String?        @map("request_id") @db.Uuid
  metadata       Json           @default("{}") @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model ElderProject {
  id                      String              @id @default(uuid()) @db.Uuid
  displayName             String?             @map("display_name") @db.VarChar(120)
  birthYear               Int?                @map("birth_year")
  approximateAge          Int?                @map("approximate_age")
  nativePlace             String?             @map("native_place") @db.VarChar(200)
  currentCity             String?             @map("current_city") @db.VarChar(200)
  status                  ProjectStatus       @default(draft)
  statusBeforeRestriction ProjectStatus?      @map("status_before_restriction")
  createdBy               String?             @map("created_by") @db.Uuid
  createdAt               DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt               DateTime?           @map("deleted_at") @db.Timestamptz(3)
  creator                 User?               @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments             ProjectAssignment[]
  serviceTerms            ServiceTerm[]
  consents                ConsentRecord[]
  interviewSessions       InterviewSession[]
  audioObjects            AudioObject[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("elder_project")
}

model ProjectAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  assignmentRole AssignmentRole @default(interviewer) @map("assignment_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  project        ElderProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("project_assignment")
}

model ServiceTerm {
  id                     String       @id @default(uuid()) @db.Uuid
  projectId              String       @map("project_id") @db.Uuid
  includedMinutes        Int          @map("included_minutes")
  estimatedSessionCount  Int          @map("estimated_session_count")
  expectedCurrentMinutes Int          @map("expected_current_minutes")
  overtimeUnitMinutes    Int          @map("overtime_unit_minutes")
  overtimePriceMinor     Int          @map("overtime_price_minor")
  currency               String       @db.Char(3)
  explainedAt            DateTime     @map("explained_at") @db.Timestamptz(3)
  explainedBy            String       @map("explained_by") @db.Uuid
  effectiveFrom          DateTime     @map("effective_from") @db.Timestamptz(3)
  supersededAt           DateTime?    @map("superseded_at") @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  project                ElderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  explainer              User         @relation("ServiceTermExplainer", fields: [explainedBy], references: [id], onDelete: Restrict)

  @@index([projectId, effectiveFrom(sort: Desc)])
  @@map("service_term")
}

model ConsentRecord {
  id                   String        @id @default(uuid()) @db.Uuid
  projectId            String        @map("project_id") @db.Uuid
  consentType          ConsentType   @default(recording_transcription_ai) @map("consent_type")
  consentTextVersion   String        @map("consent_text_version") @db.VarChar(80)
  consentMethod        ConsentMethod @map("consent_method")
  consentedAt          DateTime      @map("consented_at") @db.Timestamptz(3)
  consentAudioObjectId String?       @map("consent_audio_object_id") @db.Uuid
  status               ConsentStatus @default(valid)
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdBy            String        @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  project              ElderProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator              User          @relation("ConsentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  consentAudioObject   AudioObject?  @relation("ConsentAudioObject", fields: [consentAudioObjectId], references: [id], onDelete: Restrict)

  @@index([projectId, consentType, createdAt(sort: Desc)])
  @@map("consent_record")
}

model InterviewSession {
  id              String                 @id @default(uuid()) @db.Uuid
  projectId       String                 @map("project_id") @db.Uuid
  sequenceNo      Int                    @map("sequence_no")
  status          InterviewSessionStatus @default(created)
  startedAt       DateTime?              @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?              @map("ended_at") @db.Timestamptz(3)
  durationSeconds Int?                   @map("duration_seconds")
  asrProvider     String?                @map("asr_provider") @db.VarChar(100)
  llmProvider     String?                @map("llm_provider") @db.VarChar(100)
  promptVersion   String?                @map("prompt_version") @db.VarChar(100)
  createdBy       String                 @map("created_by") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  project         ElderProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator         User                   @relation("InterviewSessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  audioObjects    AudioObject[]

  @@unique([projectId, sequenceNo])
  @@map("interview_session")
}

model AudioObject {
  id               String            @id @default(uuid()) @db.Uuid
  projectId        String            @map("project_id") @db.Uuid
  sessionId        String?           @map("session_id") @db.Uuid
  purpose          AudioPurpose
  status           AudioObjectStatus @default(initiated)
  mimeType         String            @map("mime_type") @db.VarChar(160)
  chunkCount       Int?              @map("chunk_count")
  totalSizeBytes   BigInt?           @map("total_size_bytes")
  manifestChecksum String?           @map("manifest_checksum") @db.Char(64)
  createdBy        String            @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt      DateTime?         @map("completed_at") @db.Timestamptz(3)
  project          ElderProject      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session          InterviewSession? @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  creator          User              @relation("AudioObjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  chunks           AudioChunk[]
  consentRecords   ConsentRecord[]   @relation("ConsentAudioObject")

  @@index([projectId, purpose, createdAt(sort: Desc)])
  @@index([sessionId, purpose])
  @@map("audio_object")
}

model AudioChunk {
  id            String                 @id @default(uuid()) @db.Uuid
  audioObjectId String                 @map("audio_object_id") @db.Uuid
  sequenceNo    Int                    @map("sequence_no")
  objectKey     String                 @map("object_key") @db.VarChar(500)
  startMs       Int                    @map("start_ms")
  endMs         Int                    @map("end_ms")
  sizeBytes     Int                    @map("size_bytes")
  checksum      String                 @db.Char(64)
  mimeType      String                 @map("mime_type") @db.VarChar(160)
  uploadStatus  AudioChunkUploadStatus @default(uploaded) @map("upload_status")
  retryCount    Int                    @default(0) @map("retry_count")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt    DateTime?              @map("uploaded_at") @db.Timestamptz(3)
  audioObject   AudioObject            @relation(fields: [audioObjectId], references: [id], onDelete: Cascade)

  @@unique([audioObjectId, sequenceNo])
  @@map("audio_chunk")
}

model IdempotencyRecord {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @unique @map("request_id") @db.Uuid
  action          String   @db.VarChar(100)
  actorId         String   @map("actor_id") @db.Uuid
  targetType      String   @map("target_type") @db.VarChar(80)
  targetId        String   @map("target_id") @db.Uuid
  responsePayload Json     @map("response_payload") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor           User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@map("idempotency_record")
}
