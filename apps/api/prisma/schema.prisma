generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  interviewer
  admin
  data_admin
}

enum UserStatus {
  active
  disabled
}

enum AuditActorType {
  user
  anonymous
  system_operator
}

enum AuthThrottleKeyKind {
  identity_ip
  ip
}

enum ProjectStatus {
  draft
  ready
  active
  completed
  restricted
  deleted
}

enum AssignmentRole {
  interviewer
}

enum ConsentType {
  recording_transcription_ai
}

enum ConsentMethod {
  recorded_verbal
  electronic
  written
}

enum ConsentStatus {
  pending
  valid
  revoked
  expired
}

enum InterviewSessionStatus {
  created
  device_check
  recording
  reconnecting
  stopping
  processing
  completed
  interrupted
  failed
}

enum CaptureFailureCode {
  NO_AUDIO_CAPTURED
}

enum CaptureGenerationStatus {
  preparing
  active
  interrupted
  stopped
  abandoned_empty
}

enum CaptureInterruptionReason {
  capture_start_failed
  page_recovery_detected
  microphone_ended
  recorder_error
  local_archive_failed
  auth_lost
  unknown
}

enum AudioPurpose {
  consent
  interview
}

enum AudioObjectStatus {
  initiated
  uploading
  complete
  failed
}

enum AudioChunkUploadStatus {
  pending
  uploading
  uploaded
  failed
  missing
}

enum SpeakerRole {
  elder
  interviewer
  unknown
}

enum SpeakerMappingSource {
  calibration
  manual
  provider
  batch_remap
}

enum SpeakerStreamStatus {
  active
  closed
}

enum SpeakerCalibrationAttemptStatus {
  collecting
  confirmed
  failed
  skipped
}

enum SpeakerRoleAuthority {
  unconfirmed
  user_confirmed
}

enum TranscriptContentKind {
  conversation
  speaker_calibration
}

enum SpeakerRemapPreviewStatus {
  active
  executed
  expired
  invalidated
}

enum SpeakerCorrectionOperationType {
  single
  batch
}

enum TranscriptSource {
  realtime
  backfill
  fixture
}

enum FinalizationAudioStatus {
  awaiting_upload
  verifying
  complete
  unrecoverable
}

enum FinalizationTranscriptStatus {
  pending
  draining
  drained
  degraded
  not_started
}

enum AiJobType {
  memory_extract
  question_generate
  actual_question_reconcile
  session_note
  context_snapshot
  boundary_detect
}

enum AiJobStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

enum AiDerivedOutputType {
  memory_claim
  memory_resolution
  question_candidate
  boundary_candidate
  actual_question_catalog
  session_note
  context_snapshot
}

enum AiDerivedOutputStatus {
  current
  invalidated
  waiting_recompute
  recompute_failed
  review_required
  superseded
}

enum RetentionState {
  active
  hidden
  purging
  cleanup_failed
}

enum MemoryType {
  person
  relationship
  place
  event
  time
  time_range
  important_choice
  reason_clue
  unfinished_story
}

enum MemoryValueKind {
  exact
  range
  unknown
}

enum MemoryAuthority {
  automatic
  human_confirmed
  system_migration
}

enum MemoryResolutionKind {
  single
  range
  unknown
  conflict_set
  review_required
}

enum MemoryResolutionStatus {
  current
  pending_review
  superseded
}

enum QuestionBankReleaseStatus {
  draft
  active
  retired
}

enum QuestionBankEnvironmentScope {
  product
  internal_demo
}

enum QuestionBankKind {
  basic
  deep
}

enum QuestionPurpose {
  detail
  cause
  person
  scene
  emotion
  choice
  conflict
  turning_point
  clarify
  timeline
  transition
}

enum QuestionSensitivity {
  low
  medium
  high
}

enum QuestionSourceType {
  project_original
  licensed_external
  public_domain
  synthetic_fixture
}

enum QuestionLicenseStatus {
  project_original
  verified
  unverified
  fixture_only
}

model User {
  id                                 String                       @id @default(uuid()) @db.Uuid
  email                              String                       @unique @db.VarChar(254)
  displayName                        String                       @map("display_name") @db.VarChar(120)
  passwordHash                       String                       @map("password_hash")
  role                               UserRole
  status                             UserStatus                   @default(active)
  createdAt                          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                          DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt                         DateTime?                    @map("disabled_at") @db.Timestamptz(3)
  sessions                           AuthSession[]
  auditLogs                          AuditLog[]
  createdProjects                    ElderProject[]               @relation("ProjectCreator")
  projectAssignments                 ProjectAssignment[]
  explainedServiceTerms              ServiceTerm[]                @relation("ServiceTermExplainer")
  createdConsents                    ConsentRecord[]              @relation("ConsentCreator")
  createdInterviewSessions           InterviewSession[]           @relation("InterviewSessionCreator")
  idempotencyRecords                 IdempotencyRecord[]
  createdAudioObjects                AudioObject[]                @relation("AudioObjectCreator")
  createdSpeakerMappings             SpeakerMapping[]             @relation("SpeakerMappingCreator")
  correctedTranscripts               TranscriptSegment[]          @relation("TranscriptCorrector")
  createdSpeakerRemapPreviews        SpeakerRemapPreview[]        @relation("SpeakerRemapPreviewCreator")
  createdSpeakerCorrectionOperations SpeakerCorrectionOperation[] @relation("SpeakerCorrectionOperationCreator")
  startedSpeakerCalibrationAttempts  SpeakerCalibrationAttempt[]  @relation("SpeakerCalibrationStarter")
  resolvedSpeakerCalibrationAttempts SpeakerCalibrationAttempt[]  @relation("SpeakerCalibrationResolver")

  @@map("user")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(80)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@map("auth_session")
}

model AuthLoginThrottle {
  id              String              @id @default(uuid()) @db.Uuid
  keyHash         String              @map("key_hash") @db.Char(64)
  keyKind         AuthThrottleKeyKind @map("key_kind")
  windowStartedAt DateTime            @map("window_started_at") @db.Timestamptz(3)
  failureCount    Int                 @default(0) @map("failure_count")
  blockedUntil    DateTime?           @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyHash, keyKind])
  @@map("auth_login_throttle")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  actorReference String?        @map("actor_reference") @db.VarChar(200)
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(80)
  entityId       String?        @map("entity_id") @db.Uuid
  requestId      String?        @map("request_id") @db.Uuid
  metadata       Json           @default("{}") @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_log")
}

model ElderProject {
  id                       String              @id @default(uuid()) @db.Uuid
  displayName              String?             @map("display_name") @db.VarChar(120)
  birthYear                Int?                @map("birth_year")
  approximateAge           Int?                @map("approximate_age")
  nativePlace              String?             @map("native_place") @db.VarChar(200)
  currentCity              String?             @map("current_city") @db.VarChar(200)
  status                   ProjectStatus       @default(draft)
  statusBeforeRestriction  ProjectStatus?      @map("status_before_restriction")
  createdBy                String?             @map("created_by") @db.Uuid
  createdAt                DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt                DateTime?           @map("deleted_at") @db.Timestamptz(3)
  aiPolicyRevision         Int                 @default(0) @map("ai_policy_revision")
  aiRetentionPolicyVersion Int                 @default(1) @map("ai_retention_policy_version")
  creator                  User?               @relation("ProjectCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  assignments              ProjectAssignment[]
  serviceTerms             ServiceTerm[]
  consents                 ConsentRecord[]
  interviewSessions        InterviewSession[]
  audioObjects             AudioObject[]

  @@index([status, updatedAt(sort: Desc)])
  @@map("elder_project")
}

model ProjectAssignment {
  id             String         @id @default(uuid()) @db.Uuid
  projectId      String         @map("project_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  assignmentRole AssignmentRole @default(interviewer) @map("assignment_role")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt      DateTime?      @map("revoked_at") @db.Timestamptz(3)
  project        ElderProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("project_assignment")
}

model ServiceTerm {
  id                     String       @id @default(uuid()) @db.Uuid
  projectId              String       @map("project_id") @db.Uuid
  includedMinutes        Int          @map("included_minutes")
  estimatedSessionCount  Int          @map("estimated_session_count")
  expectedCurrentMinutes Int          @map("expected_current_minutes")
  overtimeUnitMinutes    Int          @map("overtime_unit_minutes")
  overtimePriceMinor     Int          @map("overtime_price_minor")
  currency               String       @db.Char(3)
  explainedAt            DateTime     @map("explained_at") @db.Timestamptz(3)
  explainedBy            String       @map("explained_by") @db.Uuid
  effectiveFrom          DateTime     @map("effective_from") @db.Timestamptz(3)
  supersededAt           DateTime?    @map("superseded_at") @db.Timestamptz(3)
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  project                ElderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  explainer              User         @relation("ServiceTermExplainer", fields: [explainedBy], references: [id], onDelete: Restrict)

  @@index([projectId, effectiveFrom(sort: Desc)])
  @@map("service_term")
}

model ConsentRecord {
  id                   String        @id @default(uuid()) @db.Uuid
  projectId            String        @map("project_id") @db.Uuid
  consentType          ConsentType   @default(recording_transcription_ai) @map("consent_type")
  consentTextVersion   String        @map("consent_text_version") @db.VarChar(80)
  consentMethod        ConsentMethod @map("consent_method")
  consentedAt          DateTime      @map("consented_at") @db.Timestamptz(3)
  consentAudioObjectId String?       @map("consent_audio_object_id") @db.Uuid
  status               ConsentStatus @default(valid)
  revokedAt            DateTime?     @map("revoked_at") @db.Timestamptz(3)
  createdBy            String        @map("created_by") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  project              ElderProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator              User          @relation("ConsentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  consentAudioObject   AudioObject?  @relation("ConsentAudioObject", fields: [consentAudioObjectId], references: [id], onDelete: Restrict)

  @@index([projectId, consentType, createdAt(sort: Desc)])
  @@map("consent_record")
}

model InterviewSession {
  id                          String                       @id @default(uuid()) @db.Uuid
  projectId                   String                       @map("project_id") @db.Uuid
  sequenceNo                  Int                          @map("sequence_no")
  status                      InterviewSessionStatus       @default(created)
  startedAt                   DateTime?                    @map("started_at") @db.Timestamptz(3)
  endedAt                     DateTime?                    @map("ended_at") @db.Timestamptz(3)
  durationSeconds             Int?                         @map("duration_seconds")
  captureFailureCode          CaptureFailureCode?          @map("capture_failure_code")
  asrProvider                 String?                      @map("asr_provider") @db.VarChar(100)
  llmProvider                 String?                      @map("llm_provider") @db.VarChar(100)
  promptVersion               String?                      @map("prompt_version") @db.VarChar(100)
  createdBy                   String                       @map("created_by") @db.Uuid
  createdAt                   DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  speakerRoleRevision         Int                          @default(0) @map("speaker_role_revision")
  project                     ElderProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  creator                     User                         @relation("InterviewSessionCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  audioObjects                AudioObject[]
  speakerMappings             SpeakerMapping[]
  speakerStreams              SpeakerStream[]
  speakerCalibrationAttempts  SpeakerCalibrationAttempt[]
  transcriptSegments          TranscriptSegment[]
  captureGenerations          SessionCaptureGeneration[]
  finalization                SessionFinalization?
  speakerRemapPreviews        SpeakerRemapPreview[]
  speakerCorrectionOperations SpeakerCorrectionOperation[]

  @@unique([projectId, sequenceNo])
  @@map("interview_session")
}

model AudioObject {
  id                 String                     @id @default(uuid()) @db.Uuid
  projectId          String                     @map("project_id") @db.Uuid
  sessionId          String?                    @map("session_id") @db.Uuid
  purpose            AudioPurpose
  status             AudioObjectStatus          @default(initiated)
  mimeType           String                     @map("mime_type") @db.VarChar(160)
  chunkCount         Int?                       @map("chunk_count")
  totalSizeBytes     BigInt?                    @map("total_size_bytes")
  manifestChecksum   String?                    @map("manifest_checksum") @db.Char(64)
  createdBy          String                     @map("created_by") @db.Uuid
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt        DateTime?                  @map("completed_at") @db.Timestamptz(3)
  project            ElderProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session            InterviewSession?          @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  creator            User                       @relation("AudioObjectCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  chunks             AudioChunk[]
  consentRecords     ConsentRecord[]            @relation("ConsentAudioObject")
  finalization       SessionFinalization?
  captureGenerations SessionCaptureGeneration[]

  @@index([projectId, purpose, createdAt(sort: Desc)])
  @@index([sessionId, purpose])
  @@map("audio_object")
}

model SessionCaptureGeneration {
  id                 String                     @id @default(uuid()) @db.Uuid
  sessionId          String                     @map("session_id") @db.Uuid
  audioObjectId      String                     @map("audio_object_id") @db.Uuid
  generationNo       Int                        @map("generation_no")
  audioStreamId      String                     @unique @map("audio_stream_id") @db.Uuid
  timelineOffsetMs   Int                        @map("timeline_offset_ms")
  status             CaptureGenerationStatus    @default(preparing)
  interruptionReason CaptureInterruptionReason? @map("interruption_reason")
  confirmedActiveAt  DateTime?                  @map("confirmed_active_at") @db.Timestamptz(3)
  firstPcmAcceptedAt DateTime?                  @map("first_pcm_accepted_at") @db.Timestamptz(3)
  interruptedAt      DateTime?                  @map("interrupted_at") @db.Timestamptz(3)
  stoppedAt          DateTime?                  @map("stopped_at") @db.Timestamptz(3)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(3)
  session            InterviewSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  audioObject        AudioObject                @relation(fields: [audioObjectId], references: [id], onDelete: Restrict)
  speakerStreams     SpeakerStream[]

  @@unique([sessionId, generationNo])
  @@unique([id, sessionId, audioStreamId])
  @@index([sessionId, status])
  @@map("session_capture_generation")
}

model AudioChunk {
  id            String                 @id @default(uuid()) @db.Uuid
  audioObjectId String                 @map("audio_object_id") @db.Uuid
  sequenceNo    Int                    @map("sequence_no")
  objectKey     String                 @map("object_key") @db.VarChar(500)
  startMs       Int                    @map("start_ms")
  endMs         Int                    @map("end_ms")
  sizeBytes     Int                    @map("size_bytes")
  checksum      String                 @db.Char(64)
  mimeType      String                 @map("mime_type") @db.VarChar(160)
  uploadStatus  AudioChunkUploadStatus @default(uploaded) @map("upload_status")
  retryCount    Int                    @default(0) @map("retry_count")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  uploadedAt    DateTime?              @map("uploaded_at") @db.Timestamptz(3)
  audioObject   AudioObject            @relation(fields: [audioObjectId], references: [id], onDelete: Cascade)

  @@unique([audioObjectId, sequenceNo])
  @@map("audio_chunk")
}

model SpeakerMapping {
  id                String               @id @default(uuid()) @db.Uuid
  sessionId         String               @map("session_id") @db.Uuid
  speakerStreamId   String               @map("speaker_stream_id") @db.Uuid
  speakerProviderId String               @map("speaker_provider_id") @db.VarChar(200)
  speakerRole       SpeakerRole          @map("speaker_role")
  source            SpeakerMappingSource
  authority         SpeakerRoleAuthority @default(unconfirmed)
  createdBy         String?              @map("created_by") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  supersededAt      DateTime?            @map("superseded_at") @db.Timestamptz(3)
  session           InterviewSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerStream     SpeakerStream        @relation(fields: [speakerStreamId, sessionId], references: [id, sessionId], onDelete: Cascade)
  creator           User?                @relation("SpeakerMappingCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([speakerStreamId, speakerProviderId, supersededAt])
  @@map("speaker_mapping")
}

model SpeakerStream {
  id                   String                       @id @default(uuid()) @db.Uuid
  sessionId            String                       @map("session_id") @db.Uuid
  captureGenerationId  String?                      @map("capture_generation_id") @db.Uuid
  status               SpeakerStreamStatus          @default(active)
  openedAt             DateTime                     @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt             DateTime?                    @map("closed_at") @db.Timestamptz(3)
  createdAt            DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  session              InterviewSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  captureGeneration    SessionCaptureGeneration?    @relation(fields: [captureGenerationId], references: [id], onDelete: Restrict)
  mappings             SpeakerMapping[]
  transcriptSegments   TranscriptSegment[]
  calibrationAttempts  SpeakerCalibrationAttempt[]
  remapPreviews        SpeakerRemapPreview[]
  correctionOperations SpeakerCorrectionOperation[]

  @@unique([id, sessionId])
  @@unique([id, sessionId, captureGenerationId])
  @@index([sessionId, status])
  @@map("speaker_stream")
}

model SpeakerCalibrationAttempt {
  id                  String                             @id @default(uuid()) @db.Uuid
  sessionId           String                             @map("session_id") @db.Uuid
  speakerStreamId     String                             @map("speaker_stream_id") @db.Uuid
  captureGenerationId String                             @map("capture_generation_id") @db.Uuid
  audioStreamId       String                             @map("audio_stream_id") @db.Uuid
  attemptNo           Int                                @map("attempt_no")
  status              SpeakerCalibrationAttemptStatus    @default(collecting)
  startSequenceNo     Int                                @map("start_sequence_no")
  startMs             Int                                @map("start_timeline_ms")
  endSequenceNo       Int?                               @map("end_sequence_no")
  endMs               Int?                               @map("end_timeline_ms")
  startedRequestId    String                             @unique @map("started_request_id") @db.Uuid
  resolvedRequestId   String?                            @unique @map("resolved_request_id") @db.Uuid
  startedBy           String                             @map("started_by") @db.Uuid
  resolvedBy          String?                            @map("resolved_by") @db.Uuid
  startedAt           DateTime                           @default(now()) @map("started_at") @db.Timestamptz(3)
  resolvedAt          DateTime?                          @map("resolved_at") @db.Timestamptz(3)
  createdAt           DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  session             InterviewSession                   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerStream       SpeakerStream                      @relation(fields: [speakerStreamId, sessionId], references: [id, sessionId], onDelete: Cascade)
  starter             User                               @relation("SpeakerCalibrationStarter", fields: [startedBy], references: [id], onDelete: Restrict)
  resolver            User?                              @relation("SpeakerCalibrationResolver", fields: [resolvedBy], references: [id], onDelete: Restrict)
  memberships         SpeakerCalibrationAttemptSegment[]

  @@unique([speakerStreamId, attemptNo])
  @@index([speakerStreamId, status])
  @@map("speaker_calibration_attempt")
}

model SpeakerCalibrationAttemptSegment {
  id                  String                    @id @default(uuid()) @db.Uuid
  attemptId           String                    @map("speaker_calibration_attempt_id") @db.Uuid
  transcriptSegmentId String                    @map("transcript_segment_id") @db.Uuid
  createdAt           DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  attempt             SpeakerCalibrationAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  transcriptSegment   TranscriptSegment         @relation(fields: [transcriptSegmentId], references: [id], onDelete: Cascade)

  @@unique([attemptId, transcriptSegmentId])
  @@index([transcriptSegmentId])
  @@map("speaker_calibration_attempt_segment")
}

model TranscriptSegment {
  id                      String                              @id @default(uuid()) @db.Uuid
  sessionId               String                              @map("session_id") @db.Uuid
  speakerStreamId         String                              @map("speaker_stream_id") @db.Uuid
  ingestKey               String                              @map("ingest_key") @db.VarChar(240)
  providerSegmentId       String?                             @map("provider_segment_id") @db.VarChar(200)
  speakerProviderId       String?                             @map("speaker_provider_id") @db.VarChar(200)
  originalSpeakerRole     SpeakerRole                         @default(unknown) @map("original_speaker_role")
  originalRoleAuthority   SpeakerRoleAuthority                @default(unconfirmed) @map("original_role_authority")
  speakerRoleRevision     Int                                 @default(0) @map("speaker_role_revision")
  textRevision            Int                                 @default(0) @map("text_revision")
  contentKind             TranscriptContentKind               @default(conversation) @map("content_kind")
  correctedSpeakerRole    SpeakerRole?                        @map("corrected_speaker_role")
  startMs                 Int                                 @map("start_ms")
  endMs                   Int                                 @map("end_ms")
  originalText            String                              @map("original_text") @db.Text
  correctedText           String?                             @map("corrected_text") @db.Text
  source                  TranscriptSource
  providerPayload         Json?                               @map("provider_payload") @db.JsonB
  correctedBy             String?                             @map("corrected_by") @db.Uuid
  correctedAt             DateTime?                           @map("corrected_at") @db.Timestamptz(3)
  createdAt               DateTime                            @default(now()) @map("created_at") @db.Timestamptz(3)
  session                 InterviewSession                    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  speakerStream           SpeakerStream                       @relation(fields: [speakerStreamId, sessionId], references: [id, sessionId], onDelete: Restrict)
  calibrationMemberships  SpeakerCalibrationAttemptSegment[]
  corrector               User?                               @relation("TranscriptCorrector", fields: [correctedBy], references: [id], onDelete: SetNull)
