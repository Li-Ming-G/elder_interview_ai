generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  interviewer
  admin
  data_admin
}

enum UserStatus {
  active
  disabled
}

enum AuditActorType {
  user
  system_operator
}

enum AuthThrottleKeyKind {
  identity_ip
  ip
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  displayName  String        @map("display_name") @db.VarChar(120)
  passwordHash String        @map("password_hash")
  role         UserRole
  status       UserStatus    @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  disabledAt   DateTime?     @map("disabled_at") @db.Timestamptz(3)
  sessions     AuthSession[]
  auditLogs    AuditLog[]

  @@map("user")
}

model AuthSession {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  tokenHash     String    @unique @map("token_hash") @db.Char(64)
  csrfTokenHash String    @map("csrf_token_hash") @db.Char(64)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(3)
  lastSeenAt    DateTime  @map("last_seen_at") @db.Timestamptz(3)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedReason String?   @map("revoked_reason") @db.VarChar(80)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt(sort: Desc)])
  @@map("auth_session")
}

model AuthLoginThrottle {
  id              String              @id @default(uuid()) @db.Uuid
  keyHash         String              @map("key_hash") @db.Char(64)
  keyKind         AuthThrottleKeyKind @map("key_kind")
  windowStartedAt DateTime            @map("window_started_at") @db.Timestamptz(3)
  failureCount    Int                 @default(0) @map("failure_count")
  blockedUntil    DateTime?           @map("blocked_until") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([keyHash, keyKind])
  @@map("auth_login_throttle")
}

model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String?        @map("actor_id") @db.Uuid
  actorReference String?        @map("actor_reference") @db.VarChar(200)
  action         String         @db.VarChar(100)
  entityType     String         @map("entity_type") @db.VarChar(80)
  entityId       String?        @map("entity_id") @db.Uuid
  requestId      String?        @map("request_id") @db.Uuid
  metadata       Json           @default("{}") @db.JsonB
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  actor          User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("audit_log")
}
