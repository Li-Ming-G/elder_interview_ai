# Local-only example values. Never reuse these credentials outside local/test.
APP_ENV=local
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://elder_interview_local:local_dev_only@127.0.0.1:15432/elder_interview_local
TEST_DATABASE_URL=postgresql://elder_interview_test:local_test_only@127.0.0.1:15433/elder_interview_test
AUTH_ALLOWED_ORIGINS=http://127.0.0.1:4173,http://127.0.0.1:5173
# Local/test-only non-secret example. Production must inject an independent secret value.
AUTH_LOGIN_THROTTLE_PEPPER=local_test_only_login_throttle_pepper
AI_RETENTION_CLEANUP_PEPPER=local_test_only_retention_cleanup_pepper
AUTH_SESSION_IDLE_TTL_MINUTES=30
AUTH_SESSION_ABSOLUTE_TTL_HOURS=12
# Local private adapter only. Use an environment-specific absolute path outside the repository for real runs.
AUDIO_STORAGE_ROOT=.local/audio-storage
AUDIO_CHUNK_MAX_BYTES=26214400

# Real Tencent ASR is opt-in for local verification. Staging/production fail closed unless this
# provider and all three backend-only credentials are injected by the process environment.
# ASR_PROVIDER=tencent_realtime_asr_v2
# ASR_REGION=cn_mainland
# ASR_ENGINE_MODEL_TYPE=16k_zh_en_speaker_2.0
# ASR_DIARIZATION_REQUIRED=true
# ASR_OPTIONAL_TRAINING_OPTIMIZATION=false
# TENCENT_ASR_APP_ID=<inject-outside-repository>
# TENCENT_ASR_SECRET_ID=<inject-outside-repository>
# TENCENT_ASR_SECRET_KEY=<inject-outside-repository>

# Local AI model configuration lives together here. Copy the needed entries to the ignored
# `.env.local`; never put real keys in this tracked example. See docs/local-ai-model-configuration.md.
#
# Director is ACTIVE only for the explicit local Checkpoint A command. Configure exactly one of
# these standard three-variable groups; do not configure both at once.
#
# Anthropic Messages example (AgentRouter Claude; Base URL deliberately has no /v1):
# ANTHROPIC_AUTH_TOKEN=<inject-outside-repository>
# ANTHROPIC_BASE_URL=https://co.agentrouter.org
# ANTHROPIC_MODEL=claude-opus-4-8
#
# OpenAI Chat Completions example (AgentRouter non-Claude, including an available DeepSeek model):
# OPENAI_API_KEY=<inject-outside-repository>
# OPENAI_BASE_URL=https://co.agentrouter.org/v1
# OPENAI_MODEL=<exact-model-id-from-your-AgentRouter-account>
#
# Advanced custom full-endpoint mode is optional. Use it only for a gateway that does not fit one
# of the standard groups above.
# AI_DIRECTOR_API_PROFILE=openai_chat_completions
# AI_DIRECTOR_ENDPOINT=https://gateway.example.invalid/v1/chat/completions
# AI_DIRECTOR_MODEL=<exact-provider-model-id>
# AI_DIRECTOR_API_KEY=<inject-outside-repository>
#
# P1 and P2 external-model slots are RESERVED / INACTIVE. They are documented together so their
# future configuration has one home, but the current runtime does not read or send these values.
# AI_P1_MODEL=deepseek-chat
# AI_P2_MODEL=deepseek-chat
# AI_DIRECTOR_MODEL=deepseek-chat
#
# Existing real ASR configuration remains a separate prerequisite for Checkpoint A.
